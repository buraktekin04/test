import { ExaminatonChanged, ProvisionStatusDetail, ProvisionStatusSummary, ReasonExaminationChanged } from "../..//model/provisionstateservicemodel";
import { IMessageService } from "../../services/imessageservice";


@Component({
  selector: 'mskbs-provisionstatussummary',
  templateUrl: './provisionstatussummary.component.html',
  styleUrls: ['./provisionstatussummary.component.scss']

})
export class ProvisionstatussummaryComponent implements OnInit {
    // tslint:disable-next-line:member-ordering
    @ViewChild('sectionReportDiagnosticGrid') sectionReportDiagnosticGrid: DxDataGridComponent;
    // tslint:disable-next-line:member-ordering
    @ViewChild('sectionReportSYYDiagnosticGrid') sectionReportSYYDiagnosticGrid: DxDataGridComponent;
    // tslint:disable-next-line:member-ordering
    @ViewChild('tabPanel') panel: DxTabPanelComponent;
    // tslint:disable-next-line:member-ordering
    @ViewChild('annotationTabPanel') annotationPanel: DxTabPanelComponent;
    // tslint:disable-next-line:member-ordering
    @ViewChild(DxDataGridComponent) dataGrid: DxDataGridComponent;
    @ViewChild('editor') editorForm: DynamicFormComponent;
    @ViewChild('grid') grid: DxDataGridComponent;
    @ViewChild('fileUploader') fileUploader: DxFileUploaderComponent;

  provisiondetailinput:ProvizyonDurumGiris;
  provisiondetailinputtc:ProvizyonDurumGirisTC;
  provisionsummaryinput:ProvizyonDurumOzetGiris;
  gridDataSource: ProvisionStatusDetail[]=[];
  gridDataSourceSummary:ProvisionStatusSummary[]=[];
  examinatons:ReasonExaminationChanged[]= [];
  procedures : ExaminatonChanged[] = [] ;
  selectedIndex = 0;

  constructor( private provisionService: IProvisionService,private messageService: IMessageService){
      this.provisiondetailinput = new ProvizyonDurumGiris();
      this.provisionsummaryinput = new ProvizyonDurumOzetGiris();
      this.provisiondetailinputtc = new ProvizyonDurumGirisTC();
  }
   ngOnInit() {
   
  }

    public queryProvision()
    {
        if(this.provisiondetailinputtc.alimId!=null || this.provisiondetailinputtc.kisiId!=null)
        {
          this.provisiondetailinput.kisiId = Number(this.provisiondetailinputtc.kisiId);
          this.provisiondetailinput.alimId = this.provisiondetailinputtc.alimId;

  
          this.provisionService.queryProvisionState(this.provisiondetailinput).toPromise().then(result => {  
          this.gridDataSource=[result];  // 1 obje dönüyor fakat grid list beklediği için format olarak liste tanımladık ve [res] değer atadık
               
            this.examinatons = result.muayeneler; 
            this.procedures = result.tetkikler;
            this.selectedIndex = 0;     
          
        },
        error => {   
           this.examinatons = null; 
            this.procedures = null;
            this.messageService.showError("Girilen T.C. Numarası Ve Alım Numarası İle Eşleşen Kayıt Bulunmamaktadır");
          console.log("bulunamadı") 
          }).catch(error => {
             this.examinatons = null; 
             this.procedures = null;
             this.messageService.showError("Girilen T.C. Numarası Ve Alım Numarası İle Eşleşen Kayıt Bulunmamaktadır");
          });
        }
        else
        {
          this.messageService.showError("Lütfen Form Alanlarını Eksiksiz Doldurunuz");
        }
       
    }
    public queryProvisionSummary()
    {
        if(this.provisionsummaryinput.BaslangicTarihi || this.provisionsummaryinput)
        {
          this.provisionService.queryProvisionSummaryState(this.provisionsummaryinput).toPromise().then(result => {
          this.gridDataSourceSummary=result;
        },
        error => {   
          console.log("bulunamadı") 
          this.messageService.showError("Girilen Tarih Ve Alım Numarası İle Eşleşen Kayıt Bulunmamaktadır");
          }).catch(error => {
             this.messageService.showError("Girilen Tarih Ve Alım Numarası İle Eşleşen Kayıt Bulunmamaktadır");
          });
        }
        else
        {
          this.messageService.showError("Lütfen Form Alanlarını Eksiksiz Doldurunuz");
        }
       
    }
    public gridRowClick(e) {
    // if (e.rowType == "data") {
    //   const component = e.component;
    //   const prevClickTime = component.lastClickTime;
    //   component.lastClickTime = new Date();
    //   if (prevClickTime && (component.lastClickTime - prevClickTime < 300))
    //     this.queryProvision();//this.selectedReport.raporKayitNo
    //   else {
    //     // this.showBtnMudurOnayi = true;
    //     //let selectedReport = this.queryResult.filter(x => x.raporKayitNo === this.selectedReport.raporKayitNo);

    //   }
    // }
    if(e.data)
    {
      this.gridDataSource=e.data;
    }
  }
    public selectionChangedProvision(arg:ProvisionStatusDetail) {
      if (arg ) {
        this.gridDataSource = arg[0];
      }
    }

    public selectSingleRow(key, preserve) {
      if (!this.dataGrid.instance.isRowSelected(key))
        this.dataGrid.instance.selectRows([key], preserve);
    }

  
  }





