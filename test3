import { Component, OnInit, ResolvedReflectiveFactory } from '@angular/core';
import { ProvizyonSorgulaGiris } from '../../apimodel/provizyonsorgulagiris';
import { ProvisionQueryCriteria } from '../../model/provision-query-criteria';
import { ProvisionResult } from '../../model/provision-result';
import { Router, ActivatedRoute } from '@angular/router';
import { ProvizyonOzet } from '../../apimodel/provizyonozet';
import { IProvisionService } from '../../services/iprovisionservice';
import { IMessageService } from '../../services/imessageservice';
import { MSKBSResultCodes } from '../../model/mskbsresultcodes';
import { ProvizyonIptalGiris } from '../../apimodel/provizyoniptalgiris';
import { Provision } from '../../model/provision';
import { ProvizyonDetayliSorgulaGiris } from '../../apimodel/provizyondetaylisorgulagiris';
import { Subscription } from 'rxjs';
import { AuthService } from '../../auth/services/auth.service';
import { AuditActionData } from '../../model/auditactiondata';
import { AuditData } from '../../model/auditdata';
import { EntityData } from '../../model/entitydata';
import { AuditDataDetail } from '../../model/auditdatadetail';
import { UserData } from '../../model/userdata';
import { IAuditService } from '../../services/iauditservice';
import MessagesTr from "devextreme/localization/messages/tr.json";
import { locale, loadMessages } from "devextreme/localization";

@Component({
  selector: 'mskbs-queryprovision',
  templateUrl: './queryprovision.component.html',
  styleUrls: ['./queryprovision.component.scss']
})
export class QueryProvisionComponent implements OnInit {

  private paramsSub: Subscription;
  public selectedProvision: ProvizyonOzet;
  public provizyonSorgulaGiris: ProvizyonDetayliSorgulaGiris;
  public provisionSummaryList: Array<ProvizyonOzet>;
  public isQueryProvision: boolean = false;
  public isCancelProvision: boolean = false;
  public isSaveReport: boolean = false;
  public isAuditRecord: boolean = false;
  auditOpen: boolean = false;
  public userList: Array<UserData>;
  public entityList: Array<EntityData>;
  public auditActionList: Array<AuditActionData>;
  public auditQueryResultList: Array<AuditData>;
  public auditQueryResultDetail: any;
  public newValue: Array<any>;
  public oldValue: Array<any>;
  public changeValue: Array<AuditDataDetail>;

  employeeInfo: any = {};
  loadingVisible = false;


  constructor(private router: Router,
    private authService: AuthService,
    private auditService: IAuditService,
    private provisionService: IProvisionService,
    private messageService: IMessageService,
    private activeRoute: ActivatedRoute) {
    this.provizyonSorgulaGiris = new ProvizyonDetayliSorgulaGiris();
    loadMessages(MessagesTr);
    locale('tr');
  }

  ngOnInit() {
    const isSuperUser = this.authService.isSuperUser();
    if (!isSuperUser) {
      this.isQueryProvision = !this.authService.isQueryProvision();
      this.isCancelProvision = !this.authService.isCancelProvision();
      this.isSaveReport = !this.authService.isSaveReport();
      this.isAuditRecord = !this.authService.isAuditRecord();
    }

    //if (sessionStorage.getItem("DEV_TEST"))
    //{
    this.provizyonSorgulaGiris.baslangicTarihi = new Date();
    this.provizyonSorgulaGiris.bitisTarihi = new Date();
    //}

    this.auditService.userList().toPromise().then(result => {
      this.userList = result;
    });
  }

  public selectionChanged(arg: Array<ProvizyonOzet>) {
    if (arg && arg.length > 0) {
      this.selectedProvision = arg[0];
    }
    else
      this.selectedProvision = null;
  }

  public reportEntry() {
    if (this.selectedProvision) {
      if (this.selectedProvision.durumu == 1) {
        const uri = `/mskbs/rapor/giris/${this.selectedProvision.provizyonKayitNo}`;
        this.router.navigate([uri]);
      }
      else {
        this.messageService.showError('Rapor girişi için provizyon durumu "Yeni" olmalı!');
      }
    }
    else {
      this.messageService.showError('Rapor girişi için "Yeni" durumdaki bir provizyon seçili olmalı!');
    }
  }

  GetDisplayText(d) {
    return d.data.collapsedItems ? d.value + " ( Adet :  " + d.data.collapsedItems.length + " ) " : d.value + " ( Adet :  " + d.data.items.length + " ) ";
  }

  contentReady(event: any) {
    event.component.columnOption("command:edit", "visibleIndex", -1);
  }

  public queryProvision() {
    if (this.provizyonSorgulaGiris.tcKimlikNo && !this.tcKimlikDogrula(this.provizyonSorgulaGiris.tcKimlikNo)) {
      this.messageService.showError("Girilen T.C. numarası geçersizdir.")
    }

    else {
      this.employeeInfo = {};
      this.loadingVisible = true;
      const that = this;
      this.provisionService.query(this.provizyonSorgulaGiris).toPromise().then(result => {
        const message = `${result.sonucKodu}-${result.sonucMesaji}`;
        if (result.sonucKodu === MSKBSResultCodes.SuccessResultCode) {
          if (result.provizyonlar.length > 0) {
            this.loadingVisible = false;
            that.messageService.showInfo(message);
            that.provisionSummaryList = result.provizyonlar;
          } else {
            this.loadingVisible = false;
            that.messageService.showError('Aranan kayıt bulunamadı!');
            that.provisionSummaryList = null;
          }
        } else {
          this.loadingVisible = false;
          that.messageService.showError(message);

        }
      },
        error => {
          this.loadingVisible = false;
          if (error && error.message) {
            that.messageService.showError(error.message);
            if (error.status == 401 || error.status == 0) {
              const uri = `/kimlik/giris`;
              this.router.navigate([uri]);
            }
          } else {
            if (error) {
              that.messageService.showError(error.toString());
            }
          }
        });
    }
  }

  private tcKimlikDogrula(tc: number): boolean {
    if (!tc) return true;  // Eğer TC kimlik numarası boş ise doğrulama yapılmaz
    let str = tc.toString();
    if (!/^\d{11}$/.test(str)) return false;

    let digits = str.split("").map(Number);
    if (digits[0] === 0) return false;

    let sumOdd = digits[0] + digits[2] + digits[4] + digits[6] + digits[8];
    let sumEven = digits[1] + digits[3] + digits[5] + digits[7];

    let checkDigit10 = ((sumOdd * 7) - sumEven) % 10;
    if (checkDigit10 !== digits[9]) return false;

    let totalSum = sumOdd + sumEven + digits[9];
    let checkDigit11 = totalSum % 10;
    if (checkDigit11 !== digits[10]) return false;

    return true;
  }

  public onRowPrepared(info) {
    if (info.rowType == 'data') {
      if (info.data.durumu == Provision.States.CANCEL)
        info.rowElement.style.color = '#800000';
      else if (info.data.durumu == Provision.States.REPORT)
        info.rowElement.style.color = '#008000';
      else
        info.rowElement.style.fontWeight = 500;
    }
  }


  cancelDesciptionOpen: boolean = false;
  desciptionAreaValue: string;

  cancelProvisionExit() {
    this.cancelDesciptionOpen = false;
    this.desciptionAreaValue = "";
  }

  cancelProvisionStart() {
    this.cancelDesciptionOpen = true;
  }


  public cancelProvision() {
    const that = this;
    if (!this.selectedProvision) {
      that.messageService.showError("İptal edilecek bir provizyon işlemi seçilmemiştir.");
      return;
    }

    if (this.desciptionAreaValue == null) {
      that.messageService.showError("Açıklama boş geçilemez.");
      return;
    }

    const input = new ProvizyonIptalGiris();
    input.provizyonKayitNo = this.selectedProvision.provizyonKayitNo;
    input.aciklama = that.desciptionAreaValue;

    this.provisionService.cancelProvision(input).toPromise().then(result => {
      if (result.sonucKodu === MSKBSResultCodes.SuccessResultCode) {
        that.selectedProvision.durumu = Provision.States.CANCEL;
        const message = `${this.selectedProvision.provizyonSiraNo} numaralı provizyon iptal edilmiştir.`;
        that.messageService.showInfo(message);
        this.desciptionAreaValue = "";
        this.cancelDesciptionOpen = false;
      } else {
        const message = `${result.sonucKodu}-${result.sonucMesaji}`;
        that.messageService.showError(message);
      }
    },
      error => {
        if (error && error.message) {
          that.messageService.showError(error.message);
          if (error.status == 401 || error.status == 0) {
            const uri = `/kimlik/giris`;
            this.router.navigate([uri]);
          }
        } else {
          if (error) {
            that.messageService.showError(error.toString());
          }
        }
      });
  }

  public queryAudit(): void {
    let that = this;
    if (this.selectedProvision) {
      this.auditOpen = true;
      this.auditService.queryAuditForEntity(this.selectedProvision.provizyonKayitNo).toPromise().then(result => {
        that.auditQueryResultList = result;
      }, error => {
        this.messageService.showError(error);
      });
      // const uri = `/mskbs/izkaydi/sorgula/${this.selectedProvision.provizyonKayitNo}/Provizyon`;
      // this.router.navigate([uri]);
    }
  }

  public selectionChangedAudit(data: any) {
    if (data != null) {
      this.changeValue = new Array<AuditDataDetail>();
      this.newValue = new Array<any>();
      this.oldValue = new Array<any>();
      const parseJson = (str: string): any => JSON.parse(str);
      this.auditQueryResultDetail = data as AuditData;
      let newValueParse: any;
      let oldValueParse: any;
      if (this.auditQueryResultDetail.length != 0) {
        newValueParse = parseJson(this.auditQueryResultDetail[0].newValues);
        oldValueParse = parseJson(this.auditQueryResultDetail[0].oldValues);
      }


      for (let itemUpdate in oldValueParse) {
        let chanceValueItem: AuditDataDetail = new AuditDataDetail();
        chanceValueItem.NesneAdi = itemUpdate;
        chanceValueItem.EskiVeri = oldValueParse[itemUpdate];
        if (newValueParse != null)
          chanceValueItem.YeniVeri = newValueParse[itemUpdate];
        this.changeValue.push(chanceValueItem);
      }
    }
  }
  onRowPreparedAudit(e) {
    if (e.rowType == 'data') {
      if (e.data.EskiVeri != e.data.YeniVeri) {
        e.rowElement.style.backgroundColor = 'yellow';
        e.rowElement.className = e.rowElement.className.replace("dx-row-alt", "");
      }
    }
  }

}








