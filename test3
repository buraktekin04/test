  constructor(private router: Router, private personService: IPersonService,
    private dispatchService: IDispatchService,
    private provisionService: IProvisionService,
    private authService: AuthService,
    private messageService: IMessageService,
    private fileUploadService: IFileUploadService,
    private definitionService: IDefinitionService) {
    this.viewModel = new ProvizyonSevksizYeniGirisFoto();
    this.personGetInput = new PersonGetInput();
    this.identificationnumbers = ['T.C. Kimlik No', 'Yabancı Kimlik No'];
  }


  ngOnInit() {
    const that = this;
    this.options = {
      thumbnailHeight: 100,
      thumbnailWidth: 100,
      uploadUrl: this.fileUploadService.getUploadImageUrl(),
      allowedImageTypes: ['image/png', 'image/jpeg'],
      maxImageSize: 1,
      autoUpload: true,
      authTokenPrefix: 'Bearer',
      authToken: sessionStorage.getItem('token')
    };

    this.fileUploadService.getImageSettings().toPromise().then(result => {
      that.options.thumbnailHeight = result.pictureHeight;
      that.options.thumbnailWidth = result.pictureWidth;
    });

    const isSuperUser = this.authService.isSuperUser();
    if (!isSuperUser) {
      this.isQueryPerson = !this.authService.isQueryPerson();
      this.isGetProvisionNotDispatch = !this.authService.isGetProvisionNotDispatch();
    }

    this.authService.getUserMilitaryUnit().toPromise().then(result => {
      this.viewModel.muayeneyeGonderenMakam = result.organization;
    });

    this.isTcOrForeign = this.identificationnumbers[0];
  }


  onHcAdmissinTypeValueChanged(e) {
    const newValue = e.value;
    if (newValue != null) {
      this.definitionService.getReasonForExaminationListByHcAdmissionType(newValue).toPromise().then(result => {
        this.reasonforexaminationDataSource = result.reasonForExaminationDefs;
        this.forcesCommandDefDataSource = result.forcesCommandDefs;
        this.ForcesCommoandRequired = !result.forcesCommoandRequired;
        this.LastNominationDateRequired = !result.lastNominationDateRequired;
        this.MilitaryClassRequired = !result.militaryClassRequired;
        this.MilitaryOfficeRequired = !result.militaryOfficeRequired;
        this.MilitarySchoolRequired = !result.militarySchoolRequired;
        this.MilitaryUnitRequired = !result.militaryUnitRequired;
        this.RankRequired = !result.rankRequired;
        this.RegistryNumberRequired = !result.registryNumberRequired;
        this.SenderChaireRequired = !result.senderChaireRequired;
        this.NthAdmissionRequired = !result.nthAdmissionRequired;
        this.DispatchDocumentDateRequired = !result.dispatchDocumentDateRequired;
        this.DispatchDocumentNoRequired = !result.dispatchDocumentNoRequired;
        this.reasonforexaminationDisable = false;
      });
    } else {
      this.viewModel.muayeneSebebi = null;
      this.reasonforexaminationDisable = true;
      this.ForcesCommoandRequired = true;
      this.LastNominationDateRequired = true;
      this.MilitaryClassRequired = true;
      this.MilitaryOfficeRequired = true;
      this.MilitarySchoolRequired = true;
      this.MilitaryUnitRequired = true;
      this.RankRequired = true;
      this.RegistryNumberRequired = true;
      this.SenderChaireRequired = true;
      this.NthAdmissionRequired = true;
      this.DispatchDocumentDateRequired = true;
      this.DispatchDocumentNoRequired = true;
    }
    this.changeByHcAdmissionType();
  }

  onReasonforexaminationValueChanged(e) {

    let selectedReasonForExaminationValue = this.reasonforexaminationDataSource.find(x => x.objectId == e.value);
    if (selectedReasonForExaminationValue != null) {
      this.requiredReportIdOfreasonforexamination = !selectedReasonForExaminationValue.objectionable;
      let input: ItirazRaporInput = new ItirazRaporInput();
      if (this.viewModel.tcKimlikNo != null) {
        input.uniqueRefno = this.viewModel.tcKimlikNo;

        this.provisionService.getReportLastMonthList(input).toPromise().then(r => {
          this.lastReportByPersonUniqueDataSource = r.raporlar;
        });
      }
      else if (this.viewModel.yabanciKimlikNo != null) {
        input.uniqueRefno = this.viewModel.yabanciKimlikNo;
        this.provisionService.getReportLastMonthList(input).toPromise().then(r => {
          this.lastReportByPersonUniqueDataSource = r.raporlar;
        });
      }
      else {
        this.requiredReportIdOfreasonforexamination = true;
      }
    }
  }

  changeByHcAdmissionType() {
    if (this.ForcesCommoandRequired == false && this.viewModel.kuvvet != null) {
      this.viewModel.kuvvet = null;
    }
    if (this.LastNominationDateRequired == false && this.viewModel.nasbi != null) {
      this.viewModel.nasbi = null;
    }
    if (this.MilitaryClassRequired == false && this.viewModel.sinif != null) {
      this.viewModel.sinif = null;
    }
    if (this.MilitaryOfficeRequired == false && this.viewModel.kayitliOlduguAskerlikSubesi != null) {
      this.viewModel.kayitliOlduguAskerlikSubesi = null;
    }
    if (this.MilitarySchoolRequired == false && this.viewModel.okulu != null) {
      this.viewModel.okulu = null;
    }
    if (this.MilitaryUnitRequired == false && this.viewModel.birlik != null) {
      this.viewModel.birlik = null;
    }
    if (this.RankRequired == false && this.viewModel.rutbe != null) {
      this.viewModel.rutbe = null;
    }
    if (this.RegistryNumberRequired == false && this.viewModel.sicilNo != null) {
      this.viewModel.sicilNo = null;
    }
    if (this.SenderChaireRequired == false && this.viewModel.muayeneyeGonderenMakam != null) {
      this.viewModel.muayeneyeGonderenMakam = null;
    }
    if (this.MilitaryUnitRequired == false && this.viewModel.birlikAciklama != null) {
      this.viewModel.birlikAciklama = null;
    }
    if (this.SenderChaireRequired == false && this.viewModel.muayeneyeGonderenMakamAciklama != null) {
      this.viewModel.muayeneyeGonderenMakamAciklama = null;
    }
  }

  async tc_KeyPress(event: KeyboardEvent) {
    if (event.charCode === 13) {
      this.queryPerson();
    }
  }



  public queryPerson() {
    const that = this;
    if (this.isTcOrForeign === this.identificationnumbers[0]) {
      if (that.uniqueRefno === "" || typeof that.uniqueRefno === 'undefined') {
        confirm(`Geçerli T.C. kimlik numarası girmelisiniz!`);
        that.uniqueRefno = undefined;
      }
      if (that.uniqueRefno != null && that.uniqueRefno !== undefined) {
        this.personGetInput.uniqueRefno = Number(that.uniqueRefno);
        this.personService.getPerson(this.personGetInput).toPromise().then((personRes: PersonResult) => {
          if (personRes && personRes.person) {
            const person = personRes.person;
            that.viewModel.tcKimlikNo = person.uniqueRefno;
            that.viewModel.adi = person.name;
            that.viewModel.soyadi = person.surname;
            that.viewModel.anneAdi = person.motherName;
            that.viewModel.babaAdi = person.fatherName;
            that.viewModel.cinsiyet = person.gender;
            that.viewModel.dogumTarihi = person.birthDate;
            that.viewModel.adres = person.address;
            that.viewModel.kuvvet = person.forcesCommand;
            that.viewModel.sinif = person.militaryClass;
            that.viewModel.rutbe = person.rank;
            that.viewModel.birlik = person.militaryUnit;
            that.viewModel.birlikAciklama = person.militaryUnitDescription;
            that.viewModel.okulu = person.militarySchool;
            that.viewModel.sicilNo = person.registryNumber;
            that.viewModel.nasbi = person.lastNominationDate;
            that.viewModel.kayitliOlduguAskerlikSubesi = person.militaryOffice;
            that.viewModel.ucucuGorevi = person.flyingMission;
            that.viewModel.uctuguUcakTipi = person.flyingPlaneType;

            if (person.hcAdmissionTypeDef == Guid.empty().valueOf().toString()) {
              that.viewModel.skBasvuruGrubu = null;
            } else {
              that.viewModel.skBasvuruGrubu = person.hcAdmissionTypeDef;
            }

            if (personRes.townOfBirthCode) {
              that.viewModel.dogumYeri = personRes.townOfBirthCode.toString();
            }
            if (personRes.nationalityCode) {
              that.viewModel.uyrugu = personRes.nationalityCode;
            }
          } else {
            this.messageService.showWarning(`${that.uniqueRefno} - T.C. kimlik numarası ile kişi kaydı bulunamadı.`);
          }
        });
      }
      this.personGetInput.uniqueRefno = undefined;
    }
    if (this.isTcOrForeign === this.identificationnumbers[1]) {
      if (that.foreignUniqueRefno === null || that.foreignUniqueRefno === undefined) {
        confirm(`Geçerli yabancı kimlik numarası girmelisiniz!`);
        that.foreignUniqueRefno = undefined;
      }
      if (that.foreignUniqueRefno != null && that.foreignUniqueRefno !== undefined) {
        this.personGetInput.foreignUniqueRefno = that.foreignUniqueRefno;
        this.personService.getPerson(this.personGetInput).toPromise().then((personRes: PersonResult) => {
          if (personRes && personRes.person) {
            const person = personRes.person;
            that.viewModel.yabanciKimlikNo = person.foreignUniqueRefno;
            that.viewModel.adi = person.name;
            that.viewModel.soyadi = person.surname;
            that.viewModel.anneAdi = person.motherName;
            that.viewModel.babaAdi = person.fatherName;
            that.viewModel.cinsiyet = person.gender;
            that.viewModel.dogumTarihi = person.birthDate;
            that.viewModel.adres = person.address;
            that.viewModel.skBasvuruGrubu = person.hcAdmissionTypeDef;
            that.viewModel.kuvvet = person.forcesCommand;
            that.viewModel.sinif = person.militaryClass;
            that.viewModel.rutbe = person.rank;
            that.viewModel.birlik = person.militaryUnit;
            that.viewModel.birlikAciklama = person.militaryUnitDescription;
            that.viewModel.okulu = person.militarySchool;
            that.viewModel.sicilNo = person.registryNumber;
            that.viewModel.nasbi = person.lastNominationDate;
            that.viewModel.kayitliOlduguAskerlikSubesi = person.militaryOffice;
            that.viewModel.ucucuGorevi = person.flyingMission;
            that.viewModel.uctuguUcakTipi = person.flyingPlaneType;
            if (personRes.townOfBirthCode) {
              that.viewModel.dogumYeri = personRes.townOfBirthCode.toString();
            }
            if (personRes.nationalityCode) {
              that.viewModel.uyrugu = personRes.nationalityCode;
            }
          } else {
            this.messageService.showWarning(`${that.foreignUniqueRefno} - yabancı kimlik numarası ile kişi kaydı bulunamadı.`);
          }
        });
      }
      this.personGetInput.foreignUniqueRefno = undefined;
    }
  }

  pad(number) {
    if (number < 10) {
      return '0' + number;
    }
    return number;
  }

  toISOString(date: Date) {
    return date.getUTCFullYear() +
      '-' + this.pad(date.getUTCMonth() + 1) +
      '-' + this.pad(date.getUTCDate()) +
      'T' + this.pad(date.getUTCHours()) +
      ':' + this.pad(date.getUTCMinutes()) +
      ':' + this.pad(date.getUTCSeconds()) +
      '.' + (date.getUTCMilliseconds() / 1000).toFixed(3).slice(2, 5) +
      'Z';
  }

  onSelectionChanged(event: any) {
    if (event.selectedItem != null) {
      if (event.selectedItem.code == "DIGER" || event.selectedItem.name == "DİĞER") {
        this.senderOtherReq = true;
      }
    } else {
      this.senderOtherReq = false;
    }
  }

  controlOfRequiredFiles() {
    this.controlOfRequiredMessage = "";
    this.controlOfRequired = false;
    if (this.ForcesCommoandRequired == false && this.viewModel.kuvvet == null) {
      this.controlOfRequiredMessage += "Kuvvet bilgisi boş geçilemez.";
      this.controlOfRequired = true;
    }
    if (this.LastNominationDateRequired == false && this.viewModel.nasbi == null) {
      this.controlOfRequiredMessage += "Nasbi bilgisi boş geçilemez.";
      this.controlOfRequired = true;
    }
    if (this.MilitaryClassRequired == false && this.viewModel.sinif == null) {
      this.controlOfRequiredMessage += "Sınıf bilgisi boş geçilemez.";
      this.controlOfRequired = true;
    }
    if (this.MilitaryOfficeRequired == false && this.viewModel.kayitliOlduguAskerlikSubesi == null) {
      this.controlOfRequiredMessage += "Askerlik Şubesi bilgisi boş geçilemez.";
      this.controlOfRequired = true;
    }
    if (this.MilitarySchoolRequired == false && this.viewModel.okulu == null) {
      this.controlOfRequiredMessage += "Okulu bilgisi boş geçilemez.";
      this.controlOfRequired = true;
    }
    if (this.MilitaryUnitRequired == false && this.viewModel.birlik == null) {
      this.controlOfRequiredMessage += "Birlik bilgisi boş geçilemez.";
      this.controlOfRequired = true;
    }
    if (this.RankRequired == false && this.viewModel.rutbe == null) {
      this.controlOfRequiredMessage += "Rütbe bilgisi boş geçilemez.";
      this.controlOfRequired = true;
    }
    if (this.RegistryNumberRequired == false && this.viewModel.sicilNo == null) {
      this.controlOfRequiredMessage += "Sicil Numarası bilgisi boş geçilemez.";
      this.controlOfRequired = true;
    }
    if (this.SenderChaireRequired == false && this.viewModel.muayeneyeGonderenMakam == null) {
      this.controlOfRequiredMessage += "Muayeneye Gönderen Makam bilgisi boş geçilemez.";
      this.controlOfRequired = true;
    }
    if (this.NthAdmissionRequired == false && this.viewModel.kacinciIslem == null) {
      this.controlOfRequiredMessage += "Kaçıncı işlem bilgisi boş geçilemez.";
      this.controlOfRequired = true;
    }
    if (this.DispatchDocumentDateRequired == false && this.viewModel.sevkEvrakTarihi == null) {
      this.controlOfRequiredMessage += "Sevk evrak tarihi bilgisi boş geçilemez.";
      this.controlOfRequired = true;
    }
    if (this.DispatchDocumentNoRequired == false && this.viewModel.sevkEvrakSayisi == null) {
      this.controlOfRequiredMessage += "Sevk evrak sayısı bilgisi boş geçilemez.";
      this.controlOfRequired = true;
    }
  }
  onSelectionChangedMilitaryUnit(event: any) {
    if (event.selectedItem != null) {
      if (event.selectedItem.code == "DIGER" || event.selectedItem.name == "DİĞER") {
        this.senderOtherMilitaryReq = true;
      }
      else {
        this.senderOtherMilitaryReq = false;
      }
    }
    else {
      this.senderOtherMilitaryReq = false;
    }
  }

  save() {
    if (this.form) {
      if (!this.form.valid) {
        this.messageService.showError('Zorunlu (kırmızı) alanlar boş geçilemez');
        return;
      }
    }

    if (this.senderOtherReq) {
      if (this.viewModel.muayeneyeGonderenMakamAciklama == null || this.viewModel.muayeneyeGonderenMakamAciklama == "") {
        this.messageService.showError('Muayeneye gönderen makam diğer için açıklama boş geçilemez.');
        return;
      }
    }

    if (this.senderOtherMilitaryReq) {
      if (this.viewModel.birlikAciklama == null || this.viewModel.birlikAciklama == "") {
        this.messageService.showError('Birlik açıklama diğer için açıklama boş geçilemez.');
        return;
      }
    }

    this.controlOfRequiredFiles();
    if (this.controlOfRequired) {
      this.messageService.showError(this.controlOfRequiredMessage);
      return;
    }


    const that = this;
    this.provisionService.newProvisionWithoutDispatchPhoto(this.viewModel).toPromise().then(result => {

      if (result.sonucKodu === MSKBSResultCodes.SuccessResultCode) {
        const message = `${result.sonucKodu}-${result.sonucMesaji}. ${result.provizyonSiraNo} başvuru numarası ile işlem kaydedilmiştir.`;
        that.messageService.showInfo(message);
      } else {
        const message = `${result.sonucKodu}-${result.sonucMesaji}`;
        that.messageService.showError(message);
      }
    },
      error => {
        if (error && error.message) {
          that.messageService.showError(error.message);
          if (error.status == 401 || error.status == 0) {
            const uri = `/kimlik/giris`;
            this.router.navigate([uri]);
          }
        } else {
          if (error) {
            that.messageService.showError(error.toString());
          }
        }
      });
  }

  public ngAfterViewInit(): void {
    const that = this;
    if (this.form) {
      setTimeout(function () {
        that.validateAllFields(that.form.control);
      }, 10);
    }
  }

  private validateAllFields(formGroup: FormGroup) {
    const keys = Object.keys(formGroup.controls);
    for (const key of keys) {
      const control = formGroup.get(key);
      if (control instanceof FormControl) {
        control.markAsTouched({ onlySelf: true });
      } else if (control instanceof FormGroup) {
        this.validateAllFields(control);
      }
    }
  }

  public onUpload(file: UploadedFile) {
    this.viewModel.TempBinaryDataObjectId = file.response.replace(/"/g, '');
  }

  public refNoChanged($event) {
    if ($event.value && $event.value === this.identificationnumbers[0]) {
      this.showTcNoInput = false;
      this.showForeignNoInput = true;
      this.foreignUniqueRefno = undefined;
    }
    if ($event.value && $event.value === this.identificationnumbers[1]) {
      this.showTcNoInput = true;
      this.showForeignNoInput = false;
      this.uniqueRefno = undefined;
    }
  }
}




