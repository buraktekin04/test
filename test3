import { Component, OnInit } from '@angular/core';
import { ProvizyonSevkliYeniGiris } from '../../apimodel/provizyonsevkliyenigiris';
import { ActivatedRoute, ParamMap, Router } from '@angular/router';
import { IProvisionService } from '../../services/iprovisionservice';
import { MSKBSResultCodes } from '../../model/mskbsresultcodes';
import { IMessageService } from '../../services/imessageservice';
import { AuthService } from '../../auth/services/auth.service';

@Component({
  selector: 'mskbs-newprovision',
  templateUrl: './newprovision.component.html',
  styleUrls: ['./newprovision.component.scss']
})
export class NewProvisionComponent implements OnInit {

  public viewModel: ProvizyonSevkliYeniGiris;
  public isGetProvisionWithDispatch: boolean = false;

  constructor(private router: Router, private route: ActivatedRoute,
    private authService: AuthService,
    private provisionService: IProvisionService,
    private messageService: IMessageService) {
    this.viewModel = new ProvizyonSevkliYeniGiris();
  }

  ngOnInit() {
    const that = this;
    this.route.paramMap.subscribe((params: ParamMap) => {
      // seçilen sevk ObjectId si route yoluyla buraya gönderildi
      // dispatch bilgileri yüklenecek
      that.viewModel.sevkKayitNo = params.get('id');
    });
    const isSuperUser = this.authService.isSuperUser();
    if (!isSuperUser) {
      this.isGetProvisionWithDispatch = !this.authService.isGetProvisionWithDispatch();
    }
  }

  public provizyonAl() {
    const that = this;
    this.provisionService.newProvision(this.viewModel).subscribe(result => {

      if (result.sonucKodu === MSKBSResultCodes.SuccessResultCode) {
        const message = `${result.sonucKodu}-${result.sonucMesaji}. ${result.provizyonSiraNo} başvuru numarası ile işlem kaydedilmiştir.`;
        that.messageService.showInfo(message);
      } else {
        const message = `${result.sonucKodu}-${result.sonucMesaji}.`;
        that.messageService.showError(message);
      }
    },
      error => {
        if (error && error.message) {
          that.messageService.showError(error.message);
          if (error.status == 401 || error.status == 0) {
            const uri = `/kimlik/giris`;
            this.router.navigate([uri]);
          }
        } else {
          if (error) {
            that.messageService.showError(error.toString());
          }
        }
      });
  }

}



