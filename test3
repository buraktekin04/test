  public MilitaryClassRequired: boolean = true;
  public MilitaryOfficeRequired: boolean = true;
  public MilitarySchoolRequired: boolean = true;
  public MilitaryUnitRequired: boolean = true;
  public RankRequired: boolean = true;
  public RegistryNumberRequired: boolean = true;
  public SenderChaireRequired: boolean = true;
  public NthAdmissionRequired: boolean = true;
  public DispatchDocumentDateRequired: boolean = true;
  public DispatchDocumentNoRequired: boolean = true;
  identificationnumbers: string[];
  showTcNoInput: boolean = false;
  showForeignNoInput: boolean = true;
  senderOtherReq: boolean = false;
  senderOtherMilitaryReq: boolean = false;
