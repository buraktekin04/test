import { Component, OnInit, ViewChild } from '@angular/core';
import { NgForm, FormGroup, FormControl } from '@angular/forms';
import { Router } from '@angular/router';
import { SevkYeniGiris } from '../../apimodel/sevkyenigiris';
import { SevkYeniCevapDetay } from '../../apimodel/sevkyenicevapdetay';
import { SevkYeniTopluGiris } from '../../apimodel/sevkyenitoplugiris';
import { MSKBSResultCodes } from '../../model/mskbsresultcodes';
import { IDispatchService } from '../../services/idispatch.service';
import { IMessageService } from '../../services/imessageservice';


@Component({
  selector: 'app-newdispatchmultiple',
  templateUrl: './newdispatchmultiple.component.html',
  styleUrls: ['./newdispatchmultiple.component.scss']
})
export class NewDispatchMultipleComponent implements OnInit {

  @ViewChild('form') form: NgForm;

  public fileOfxml: string;
  public sonucSevkYeniCevapDetay: Array<SevkYeniCevapDetay>;

  constructor(private router: Router, private messageService: IMessageService,
    private dispatchService: IDispatchService) {

  }

  ngOnInit() {
    this.sonucSevkYeniCevapDetay = new Array<SevkYeniCevapDetay>();
  }


  readDocumentClick($event) {
    let that = this;
    const file: File = $event.target.files[0];
    let reader = new FileReader();

    reader.onload = (e) => {
      var fileUrl = (e.target as FileReader).result;
      //var fileR = e.target.result;
      this.fileOfxml = fileUrl.toString();
    };

    //reader.onerror = (e) => alert($event.target.error.name);
    reader.readAsText(file);
  }

  async string2JsonConvert(fileXml: string, inputObject: SevkYeniTopluGiris) {
    inputObject.sevkYeniGiris = new Array<SevkYeniGiris>();
    const parseOf: string[] = fileXml.split("},");
    for (let i = 0; parseOf.length > i; i++) {
      if (parseOf[i].includes('}') == false) {
        parseOf[i] = parseOf[i] + "}";
      }
      let convertObject: Object = JSON.parse(parseOf[i]);
      inputObject.sevkYeniGiris.push(convertObject as SevkYeniGiris);
    }

    return inputObject;
  }

  async save() {
    const that = this;
    if (that.fileOfxml == null) {
      that.messageService.showError("Dosya seçimi yapılmadan işlem devam ettirilemez.");
      return;
    }

    try {
      let inputObject = new SevkYeniTopluGiris;
      inputObject = await this.string2JsonConvert(that.fileOfxml, inputObject);
      if (inputObject == null) {
        that.messageService.showError("Seçimi yapılan dosya nesneleri bozuktur lütfen kontrol ediniz.");
        return;
      }

      this.dispatchService.newDispatchMultiple(inputObject).toPromise().then(result => {
        if (result.sonucKodu === MSKBSResultCodes.SuccessResultCode) {
          const message = `${result.sonucKodu}-${result.sonucMesaji} sevk işlemleri kaydedilmiştir.`;
          that.messageService.showInfo(message);
          that.sonucSevkYeniCevapDetay = result.sevkYeniCevapDetay;
        } else {
          const message = `${result.sonucKodu}-${result.sonucMesaji}.`;
          that.messageService.showError(message);
          that.sonucSevkYeniCevapDetay = result.sevkYeniCevapDetay;
        }
      },
        error => {
          if (error && error.message) {
            that.messageService.showError(error.message);
            if (error.status == 401 || error.status == 0) {
              const uri = `/kimlik/giris`;
              this.router.navigate([uri]);
            }
          } else {
            if (error) {
              that.messageService.showError(error.toString());
            }
          }
        });
    } catch (e) {
      that.messageService.showError("Dosya formatı uygun değildir.");
      return;
    }
  }
}







