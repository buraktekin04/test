@Component({
  selector: 'mskbs-newdispatch',
  templateUrl: './newdispatch.component.html',
  styleUrls: ['./newdispatch.component.scss']
})
export class NewDispatchComponent implements OnInit, AfterViewInit {

  public viewModel: SevkYeniGirisFoto;
  public uniqueRefno: string;
  public foreignUniqueRefno: number;
  public birthDate: Date;
  public dogumTarihi: Date;
  public isTcOrForeign: string;
  public personGetInput: PersonGetInput;
  public person: Person;
  public selectedId: string;
  public fileValue: any[] = [];
  public options: FancyImageUploaderOptions;
  public isQueryPerson: boolean = false;
