<!--Başvuran Kişi Bilgileri-->
<div class="row">
  <div class="col-md-12">
    <nb-card class="inline-form-card">
      <nb-card-header id="header">Başvuran Kişi</nb-card-header>
      <nb-card-body style="padding-bottom:0px">
        <div class="row">
          <div class="col-sm-2">
            <div class="form-group">
              <dx-radio-group layout="horizontal" [items]="identificationnumbers" [value]="identificationnumbers[0]"
                [(value)]="isTcOrForeign" [ngClass]="isTcOrForeign" (onValueChanged)="refNoChanged($event)">
                <div *dxTemplate="let isTcOrForeign of 'item'">
                  <div>{{isTcOrForeign}}</div>
                </div>
              </dx-radio-group>
            </div>
          </div>
          <div class="col-sm-2">
            <div class="form-group">
              <dx-text-box [(value)]="uniqueRefno" [showClearButton]="true" placeholder="T.C. Kimlik No"
                mask="00000000000" showMaskMode="onFocus" maskInvalidMessage="" maskChar="#" [disabled]="showTcNoInput"
                (keypress)="tc_KeyPress($event)">
              </dx-text-box>
            </div>
          </div>
          <div class="col-sm-2">
            <div class="form-group">
              <dx-number-box [(value)]="foreignUniqueRefno" [showClearButton]="true" placeholder="Yabancı Kimlik No"
                [disabled]="showForeignNoInput">
              </dx-number-box>
            </div>
          </div>
          <div class="col-md-2">
            <div class="form-group">
              <dx-date-box dateSerializationFormat="yyyy-MM-ddTHH:mm:ss" name="birthdate" 
                placeholder="Doğum Tarihi" [showClearButton]="true" width="%100" type="date"
                [(value)]="dogumTarihi" required="true"></dx-date-box>
            </div>
          </div>
          <div class="col-sm-2" [hidden]="isQueryPerson">
            <div class="form-group">
              <dx-button id="btnStyle" (onClick)="queryPerson()" type="Default" text="Sorgula"
                [disabled]="isQueryPerson"></dx-button>
            </div>
          </div>


          <div class="col-sm-2" [hidden]="isQueryPerson">
            <div class="form-group">
              <dx-button id="btnStyle" (onClick)="qrCodeRead()" type="Default" text="QR Kod Okut"></dx-button>
            </div>
          </div>
        </div>
      </nb-card-body>
    </nb-card>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <nb-card class="inline-form-card">
      <nb-card-header id="header">Sevk Giriş</nb-card-header>
      <nb-card-body>
        <form #form="ngForm" novalidate (ngSubmit)="save()">
          <div class="row">
            <!--Kişi ve Sevk Bilgileri-->
            <div class="col-sm-6">
              <p style="font-weight: bold;font-size: large; margin-bottom: -1%;margin-top: -1%;">Kişi Bilgileri</p>
              <hr style="width:100%;text-align:left;margin-left:0">
              <div class="row">
                <div class="col-sm-9">
                  <div class="row">
                    <div class="col-sm-6" style="padding-right: 8%;">
                      <div class="form-group">
                        <label for="tcKimlikNo">T.C. Kimlik No</label>
                        <dx-text-box name="tcKimlikNo" [showClearButton]="true" placeholder="T.C. Kimlik No" 
                         maskInvalidMessage="11 karakter giriniz"
                          [ngModel]="viewModel?.tcKimlikNo" digit="11"
                          (ngModelChange)="viewModel ? viewModel.tcKimlikNo = $event : null ">
                        </dx-text-box>
                      </div>
                    </div>
                    <div class="col-sm-6" style="padding-right: 8%;margin-left: -6%;">
                      <div class="form-group">
                        <label for="yabanciKimlikNo">Yabancı Kimlik No</label>
                        <dx-number-box name="yabanciKimlikNo" [showClearButton]="true" placeholder="Yabancı Kimlik No"
                          [ngModel]="viewModel?.yabanciKimlikNo"
                          (ngModelChange)="viewModel ? viewModel.yabanciKimlikNo = $event : null">
                        </dx-number-box>
                      </div>
                    </div>
                  </div>
                  <div class="row">
                    <div class="col-sm-6" style="padding-right: 8%;">
                      <div class="form-group">
                        <label for="adi">Adı</label>
                        <dx-text-box name="adi" [showClearButton]="true" placeholder="Adı" [ngModel]="viewModel?.adi"
                          (ngModelChange)="viewModel ? viewModel.adi = $event : null" required></dx-text-box>
                      </div>
                    </div>
                    <div class="col-sm-6" style="padding-right: 8%;margin-left: -6%;">
                      <div class="form-group">
                        <label for="soyadi">Soyadı</label>
                        <dx-text-box name="soyadi" [showClearButton]="true" placeholder="Soyadı"
                          [ngModel]="viewModel?.soyadi" (ngModelChange)="viewModel ? viewModel.soyadi = $event : null"
                          required></dx-text-box>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-sm-3">

                  <dx-button text="Kamera" [(disabled)]="camDisable" rtlEnabled="true" icon="photo"
                    (onClick)="openCam()" style="margin-left: -60px;margin-bottom: 5px;">
                  </dx-button>
                  <dx-button text="Resim" [(disabled)]="pictureDisable" rtlEnabled="true" icon="image"
                    (onClick)="closeCam()" style="margin-bottom: 5px;">
                  </dx-button>


                  <div *ngIf="!camOpen" style="height: 100px;">
                    <fancy-image-uploader #imageUploader [options]="options" (onUpload)="onUpload($event)">
                    </fancy-image-uploader>
                  </div>
                  <div *ngIf="camOpen" style="height: 100px;" style="margin-left: -120px;">
                    <photo-capture (CapturedPhotoChange)="photoCaptured($event)" [options]="options">
                    </photo-capture>
                  </div>



                </div>
              </div>
              <div class="row">
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="anneAdi">Ana Adı</label>
                    <dx-text-box name="anneAdi" [showClearButton]="true" placeholder="Ana Adı"
                      [ngModel]="viewModel?.anneAdi" (ngModelChange)="viewModel ? viewModel.anneAdi = $event : null"
                      required></dx-text-box>
                  </div>
                </div>
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="babaAdi">Baba Adı</label>
                    <dx-text-box name="babaAdi" [showClearButton]="true" placeholder="Baba Adı"
                      [ngModel]="viewModel?.babaAdi" (ngModelChange)="viewModel ? viewModel.babaAdi = $event : null"
                      required></dx-text-box>
                  </div>
                </div>
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="uyrugu">Uyruğu</label>
                    <dx-select-box name="uyrugu" placeholder="Uyruğu" [mskbsSelectDefinition]="'countryCode'"
                      [ngModel]="viewModel?.uyrugu" (ngModelChange)="viewModel ? viewModel.uyrugu = $event : null"
                      required>
                    </dx-select-box>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="dogumYeri">Doğum Yeri</label>
                    <dx-select-box name="dogumYeri" placeholder="Doğum Yeri" [mskbsSelectDefinition]="'town'"
                      [ngModel]="viewModel?.dogumYeri" (ngModelChange)="viewModel ? viewModel.dogumYeri = $event : null">
                    </dx-select-box>
                  </div>
                </div>
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="dogumTarihi">Doğum Tarihi</label>
                    <dx-date-box dateSerializationFormat="yyyy-MM-ddTHH:mm:ss" name="dogumTarihi" [min]="min"
                      [max]="now" [showClearButton]="true" placeholder="Doğum Tarihi" [style.width]="'100%'"
                      [ngModel]="viewModel?.dogumTarihi" type="date"
                      (ngModelChange)="viewModel ? viewModel.dogumTarihi = $event : null" required></dx-date-box>
                  </div>
                </div>
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="cinsiyet">Cinsiyet</label>
                    <dx-select-box name="cinsiyet" placeholder="Cinsiyet" [mskbsSelectDefinition]="'gender'"
                      [ngModel]="viewModel?.cinsiyet" (ngModelChange)="viewModel ? viewModel.cinsiyet = $event : null"
                      required>
                    </dx-select-box>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="phoneNumber">Telefon No</label>
                    <dx-number-box name="phoneNumber" placeholder="Telefon No"  [inputAttr]="{ 'maxlength': 10 }"
                      [ngModel]="viewModel?.telefonNo"
                      (ngModelChange)="viewModel ? viewModel.telefonNo = $event : null">
                    </dx-number-box>
                  </div> 
                </div>
              </div>
              <div class="row">
                <div class="col-lg-12 col-sm-12">
                  <div class="form-group">
                    <label for="address">Adres</label>
                    <dx-text-area name="address" placeholder="Adres" [ngModel]="viewModel?.adres"
                      (ngModelChange)="viewModel ? viewModel.adres = $event : null" required>
                    </dx-text-area>
                  </div>
                </div>
              </div>
              <br />
              <br />
              <p style="font-weight: bold;font-size: large; margin-bottom: -1%;">Sevk Bilgileri</p>
              <hr style="width:100%;text-align:left;margin-left:0">
              <div class="row">
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="nthadmission">Kaçıncı İşlem</label>
                    <dx-number-box name="nthadmission" [showClearButton]="true" placeholder="Kaçıncı İşlem"
                      [ngModel]="viewModel?.kacinciIslem"
                      (ngModelChange)="viewModel ? viewModel.kacinciIslem = $event : null"></dx-number-box>
                  </div>
                </div>
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="dispatchdocumentdate">Sevk Evrak Tarihi</label>
                    <dx-date-box dateSerializationFormat="yyyy-MM-ddTHH:mm:ss" name="dispatchdocumentdate" [min]="min"
                      [max]="now" [showClearButton]="true" placeholder="Sevk Evrak Tarihi" [style.width]="'100%'"
                      type="date" [ngModel]="viewModel?.sevkEvrakTarihi"
                      (ngModelChange)="viewModel ? viewModel.sevkEvrakTarihi = $event : null" required></dx-date-box>
                  </div>
                </div>
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="dispatchdocumentno">Sevk Evrak Sayısı</label>
                    <dx-text-box name="dispatchdocumentno" [showClearButton]="true" placeholder="Sevk Evrak Sayısı"
                      [ngModel]="viewModel?.sevkEvrakSayisi"
                      (ngModelChange)="viewModel ? viewModel.sevkEvrakSayisi = $event : null" required></dx-text-box>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="dispatchscope">Sevk Kapsamı</label>
                    <dx-select-box name="dispatchscope" placeholder="Sevk Kapsamı"
                      [mskbsSelectDefinition]="'dispatchscope'" [ngModel]="viewModel?.sevkKapsami"
                      (ngModelChange)="viewModel ? viewModel.sevkKapsami = $event : null" required
                      (onValueChanged)="onSevkKapsamiChanged($event)">
                    </dx-select-box>
                  </div>
                </div>
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="dispatchscopeprovince">Sevk Kapsamı Şehir</label>
                    <dx-select-box [disabled]="showSevkKapsamiSehir" name="dispatchscopeprovince"
                      placeholder="Sevk Kapsamı Şehir" [mskbsSelectDefinition]="'city'"
                      [ngModel]="viewModel?.sevkKapsamiSehir"
                      (ngModelChange)="viewModel ? viewModel.sevkKapsamiSehir = $event : null" required>
                    </dx-select-box>
                  </div>
                </div>
                <div class="col-sm-4">
                  <div class="form-group">
                    <label for="dispatchspurchaseid">Alım ID</label>
                    <dx-number-box name="dispatchspurchaseid" [showClearButton]="true" placeholder="Sevk Alım ID"
                      [ngModel]="viewModel?.alimId" (ngModelChange)="viewModel ? viewModel.alimId = $event : null">
                    </dx-number-box>
                  </div>
                </div>
           
              </div>
              <div class="row">
                <div class="col-sm-12">
                  <div class="form-group">
                    <label for="dispatchscopehospital">Sevk Kapsamı Hastane</label>
                    <dx-select-box [disabled]="showSevkKapsamiHastane" name="dispatchscopehospital"
                      placeholder="Sevk Kapsamı Hastane" [mskbsSelectDefinition]="'hospitalCode'"
                      [ngModel]="viewModel?.sevkKapsamiHastane"
                      (ngModelChange)="viewModel ? viewModel.sevkKapsamiHastane = $event : null" required>
                    </dx-select-box>
                  </div>
                </div>
              </div>
              
            </div>
            <!--Askeri Bilgileri-->
            <div class="col-sm-6">
              <p style="font-weight: bold;font-size: large; margin-bottom: -1%;margin-top: -1%;">Askeri Bilgileri</p>
              <hr style="width:100%;text-align:left;margin-left:0">
              <div class="row">
                <div class="col-sm-12">
                  <div class="form-group">
                    <label for="hcadmissiontype">Başvuru Grubu</label>
                    <dx-select-box name="hcadmissiontype" placeholder="Başvuru Grubu"
                      [mskbsSelectDefinition]="'admissiontype'" [ngModel]="viewModel?.skBasvuruGrubu"
                      (onValueChanged)="onHcAdmissinTypeValueChanged($event)"
                      (ngModelChange)="viewModel ? viewModel.skBasvuruGrubu = $event : null" required>
                    </dx-select-box>
                  </div>
                </div>
                <div class="col-sm-12">
                  <div class="form-group">
                    <label for="reasonforexamination">Muayene Sebebi</label>
                    <dx-select-box name="reasonforexamination" placeholder="Muayene Sebebi"
                      [(dataSource)]="reasonforexaminationDataSource" [(disabled)]="reasonforexaminationDisable"
                      [mskbsSelectDefinition]="'reasonforexaminationforhcaddmision'"
                      [ngModel]="viewModel?.muayeneSebebi"
                      (ngModelChange)="viewModel ? viewModel.muayeneSebebi = $event : null" 
                      required>
                    </dx-select-box>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-6">
                  <div class="form-group">
                    <label for="forcescommand">Kuvvet</label>
                    <dx-select-box name="forcescommand" placeholder="Kuvvet" [mskbsSelectDefinition]="'forcescommand'"
                      [(dataSource)]="forcesCommandDefDataSource" [ngModel]="viewModel?.kuvvet"
                      [(disabled)]="ForcesCommoandRequired" [ngModel]="viewModel?.kuvvet"
                      (ngModelChange)="viewModel ? viewModel.kuvvet = $event : null" required>
                    </dx-select-box>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="form-group">
                    <label for="militaryclass">Sınıfı</label>
                    <dx-select-box name="militaryclass" placeholder="Sınıfı" [mskbsSelectDefinition]="'militaryclass'"
                      [(disabled)]="MilitaryClassRequired" [ngModel]="viewModel?.sinif"
                      (ngModelChange)="viewModel ? viewModel.sinif = $event : null" required>
                    </dx-select-box>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-6">
                  <div class="form-group">
                    <label for="rank">Rütbesi</label>
                    <dx-select-box name="rank" placeholder="Rütbesi" [mskbsSelectDefinition]="'rank'"
                      [(disabled)]="RankRequired" [ngModel]="viewModel?.rutbe"
                      (ngModelChange)="viewModel ? viewModel.rutbe = $event : null" required>
                    </dx-select-box>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="form-group">
                    <label for="registrynumber">Sicil No</label>
                    <dx-text-box name="registrynumber" [showClearButton]="true" placeholder="Sicil No"
                      [(disabled)]="RegistryNumberRequired" [ngModel]="viewModel?.sicilNo"
                      (ngModelChange)="viewModel ? viewModel.sicilNo = $event : null" required>
                    </dx-text-box>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-12">
                  <div class="form-group">
                    <label for="militaryunit">Birliği</label>
                    <dx-select-box name="militaryunit" placeholder="Birliği" [mskbsSelectDefinition]="'militaryunit'"
                      [(disabled)]="MilitaryUnitRequired" [ngModel]="viewModel?.birlik"
                      (onSelectionChanged)="onSelectionChangedMilitaryUnit($event)"
                      (ngModelChange)="viewModel ? viewModel.birlik = $event : null" required>
                    </dx-select-box>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-12">
                  <div class="form-group">
                    <label for="senderchair">Muayeneye Gönderen Makam</label>
                    <dx-select-box name="senderchair" placeholder="Muayeneye Gönderen Makam"
                      (onSelectionChanged)="onSelectionChanged($event)"
                      [mskbsSelectDefinition]="'militaryunitandoffice'" [ngModel]="viewModel?.muayeneyeGonderenMakam"
                      (ngModelChange)="viewModel ? viewModel.muayeneyeGonderenMakam = $event : null" required>
                      <!-- [(disabled)]="SenderChaireRequired"  -->
                    </dx-select-box>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-12">
                  <div class="form-group">
                    <label for="school">Okulu</label>
                    <dx-select-box name="school" placeholder="Okulu" [mskbsSelectDefinition]="'militaryschool'"
                      [(disabled)]="MilitarySchoolRequired" [ngModel]="viewModel?.okulu"
                      (ngModelChange)="viewModel ? viewModel.okulu = $event : null" required>
                    </dx-select-box>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-6">
                  <div class="form-group">
                    <label for="militaryoffice">Askerlik Şubesi</label>
                    <dx-select-box name="militaryoffice" placeholder="Askerlik Şubesi"
                      [(disabled)]="MilitaryOfficeRequired" [mskbsSelectDefinition]="'militaryoffice'"
                      [ngModel]="viewModel?.kayitliOlduguAskerlikSubesi"
                      (ngModelChange)="viewModel ? viewModel.kayitliOlduguAskerlikSubesi = $event : null" required>
                    </dx-select-box>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="form-group">
                    <label for="lastnominationdate">Nasbı</label>
                    <dx-date-box dateSerializationFormat="yyyy-MM-ddTHH:mm:ss" name="lastnominationdate" [min]="min"
                      [max]="now" [showClearButton]="true" placeholder="Nasbı" type="date" [style.width]="'100%'"
                      [(disabled)]="LastNominationDateRequired" [ngModel]="viewModel?.nasbi"
                      (ngModelChange)="viewModel ? viewModel.nasbi = $event : null" required>
                    </dx-date-box>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-6">
                  <div class="form-group">
                    <label for="flyingmission">Uçucu Görev</label>
                    <dx-select-box name="flyingmission" placeholder="Uçucu Görev"
                      [mskbsSelectDefinition]="'flyingmission'" [ngModel]="viewModel?.ucucuGorevi"
                      (ngModelChange)="viewModel ? viewModel.ucucuGorevi = $event : null">
                    </dx-select-box>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="form-group">
                    <label for="planetype">Uçtuğu Uçak Tipi</label>
                    <dx-select-box name="planetype" placeholder="Uçtuğu Uçak Tipi" [mskbsSelectDefinition]="'planetype'"
                      [ngModel]="viewModel?.uctuguUcakTipi"
                      (ngModelChange)="viewModel ? viewModel.uctuguUcakTipi = $event : null">
                    </dx-select-box>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-lg-12 col-sm-12">
                  <div class="form-group">
                    <label>Birlik Açıklama</label>
                    <dx-text-area placeholder="Birlik Açıklama" [(ngModel)]="viewModel.birlikAciklama"
                      [(disabled)]="MilitaryUnitRequired" name="birlikAciklama">
                    </dx-text-area>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-lg-12 col-sm-12">
                  <div class="form-group">
                    <label for="description">Muayeneye Gönderen Makam Açıklama</label>
                    <dx-text-area name="description" placeholder="Muayeneye Gönderen Makam Açıklama"
                      [ngModel]="viewModel?.muayeneyeGonderenMakamAciklama" 
                      (ngModelChange)="viewModel ? viewModel.muayeneyeGonderenMakamAciklama = $event : null">
                      <!-- [(disabled)]="SenderChaireRequired" -->
                    </dx-text-area>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </nb-card-body>
    </nb-card>
  </div>
</div>
<div class="row">
  <div class="col-sm-2" [hidden]="isSaveDispatch">
    <div class="form-group">
      <dx-button id="btnStyle" (onClick)="save()" type="Default" text="Sevk Kayıt" [disabled]="isSaveDispatch">
      </dx-button>
    </div>
  </div>
</div>

