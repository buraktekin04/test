  openCam() {
    this.camOpen = true;
    this.camDisable = true;
    this.pictureDisable = false;
    if (this.viewModel.TempBinaryDataObjectId) {
      this.viewModel.TempBinaryDataObjectId = null;
    }
  }

  cameraoff() {
    const videoElem = <any>document.getElementsByTagName("video")[0];
    if (videoElem) {
      const stream = videoElem.srcObject;
      if (stream) {

        stream.getTracks().forEach((track) => {
          track.stop();
        });

        videoElem.srcObject = null;
      }
    }
    if (this.viewModel.TempBinaryDataObjectId) {
      this.viewModel.TempBinaryDataObjectId = null;
    }
  }


  closeCam() {
    let that = this;
    this.camOpen = false;
    this.camDisable = false;
    this.pictureDisable = true;
    this.cameraoff();
    this.options = {
      thumbnailHeight: 100,
      thumbnailWidth: 100,
      uploadUrl: this.fileUploadService.getUploadImageUrl(),
      allowedImageTypes: ['image/png', 'image/jpeg'],
      maxImageSize: 1,
      autoUpload: true,
      authTokenPrefix: 'Bearer',
      authToken: sessionStorage.getItem('token')
    };
    this.fileUploadService.getImageSettings().subscribe(result => {
      that.options.thumbnailHeight = result.pictureHeight;
      that.options.thumbnailWidth = result.pictureWidth;
    });

  }

