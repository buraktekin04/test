querydispatch.component.html
<div class="row">
    <div class="col-md-12">
        <nb-card class="inline-form-card">
            <nb-card-header id="header">Sevk Sorgulama Kriterleri</nb-card-header>
            <nb-card-body style="padding-bottom:0px">

                <div class="row">
                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="dispatchfromdate">Başlangıç Tarihi</label>
                            <dx-date-box dateSerializationFormat="yyyy-MM-ddTHH:mm:ss" id="dispatchfromdate"
                                [showClearButton]="true" placeholder="Sevk Başlangıç Tarihi" [style.width]="'100%'"
                                [(ngModel)]="sevkSorgulaGiris.baslangicTarihi" type="date"></dx-date-box>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="dispatchtodate">Bitiş Tarihi</label>
                            <dx-date-box dateSerializationFormat="yyyy-MM-ddTHH:mm:ss" id="dispatchtodate"
                                [showClearButton]="true" placeholder="Sevk Bitiş Tarihi" [style.width]="'100%'"
                                [(ngModel)]="sevkSorgulaGiris.bitisTarihi" type="date"></dx-date-box>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="dispatchstate">Sevk Durumu</label>
                            <dx-select-box id="dispatchstate" [showClearButton]="true" placeholder="Sevk Durumu"
                                [mskbsSelectDefinition]="'dispatchstate'" [(ngModel)]="sevkSorgulaGiris.sevkDurumu">
                            </dx-select-box>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="dispatchno">Sevk Sıra No</label>
                            <dx-number-box id="dispatchno" [showClearButton]="true" placeholder="Sevk Sıra No"
                                [(ngModel)]="sevkSorgulaGiris.sevkSiraNo"></dx-number-box>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="purchasenumber">Alım ID</label>
                            <dx-number-box id="purchasenumber" [showClearButton]="true" placeholder="Alım ID"
                                [(ngModel)]="sevkSorgulaGiris.sevkAlimId"></dx-number-box>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="uniquerefno">T.C. Kimlik No</label>
                            <dx-text-box id="uniquerefno" [(ngModel)]="sevkSorgulaGiris.tcKimlikNo"
                                placeholder="T.C. Kimlik No" mask="00000000000" [showClearButton]="true"
                                showMaskMode="onFocus" maskInvalidMessage="" maskChar="#">
                            </dx-text-box>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="foreignuniquerefno">Yabancı Kimlik No</label>
                            <dx-number-box id="foreignuniquerefno" [showClearButton]="true"
                                [(ngModel)]="sevkSorgulaGiris.yabanciKimlikNo" placeholder="Yabancı Kimlik No">
                            </dx-number-box>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="name">Adı</label>
                            <dx-text-box id="name" [showClearButton]="true" placeholder="Adı"
                                [(ngModel)]="sevkSorgulaGiris.adi"></dx-text-box>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="surname">Soyadı</label>
                            <dx-text-box id="surname" [showClearButton]="true" placeholder="Soyadı"
                                [(ngModel)]="sevkSorgulaGiris.soyadi"></dx-text-box>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label for="senderchair">Muayeneye Gönderen Makam</label>
                            <dx-select-box id="senderchair" [showClearButton]="true"
                                placeholder="Muayeneye Gönderen Makam" [mskbsSelectDefinition]="'militaryunitandoffice'"
                                [(ngModel)]="sevkSorgulaGiris.muayeneyeGonderenMakam">
                            </dx-select-box>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="dispatchScope">Sevk Kapsamı</label>
                            <dx-select-box id="dispatchScope" [showClearButton]="true"
                                [(ngModel)]="sevkSorgulaGiris.sevkKapsami" placeholder="Sevk Kapsamı"
                                [mskbsSelectDefinition]="'dispatchscope'">
                            </dx-select-box>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="form-group">
                            <label for="dispatchScopeProvince">Sevk Kapsamı Şehir</label>
                            <dx-select-box id="dispatchScopeProvince" [showClearButton]="true"
                                [(ngModel)]="sevkSorgulaGiris.sevkKapsamiSehir" placeholder="Sevk Kapsamı Şehir"
                                [mskbsSelectDefinition]="'citydef'">
                            </dx-select-box>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="form-group">
                            <label for="dispatchScopeHospital">Sevk Kapsamı Hastane</label>
                            <dx-select-box id="dispatchScopeHospital" [showClearButton]="true"
                                placeholder="Sevk Kapsamı Hastane" [mskbsSelectDefinition]="'hospital'"
                                [(ngModel)]="sevkSorgulaGiris.sevkKapsamiHastane">
                            </dx-select-box>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <dx-check-box id="checkBox" text="Bağlı Organizasyonlarıda Listele"
                            [(ngModel)]="sevkSorgulaGiris.bagliOrganizasyonlar">
                        </dx-check-box>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-2" [hidden]="isQueryDispatch">
                        <div class="form-group">
                            <dx-button id="btnquery" (onClick)="queryDispatch()" type="Default" text="Listele"
                                [disabled]="isQueryDispatch"></dx-button>
                        </div>
                    </div>
                </div>
            </nb-card-body>
        </nb-card>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <nb-card class="inline-form-card">
            <nb-card-header id="header">Sevk Sorgulama Sonuçları</nb-card-header>
            <nb-card-body>

                <dx-data-grid [dataSource]="dispatchSummaryList" mskbsGridLayout
                    (onSelectionChanged)="selectionChanged($event.currentSelectedRowKeys)" [height]="400"
                    (onRowPrepared)="onRowPrepared($event)" [width]="'100%'" [showColumnLines]="true"
                    [showRowLines]="true" [showBorders]="true" [rowAlternationEnabled]="true"
                    [groupPanel]="{visible: true}" [allowColumnReordering]="true" [allowColumnResizing]="true"
                    (onContentReady)="contentReady($event)">
                    <dxo-selection mode="single"></dxo-selection>
                    <dxo-header-filter [visible]="true"></dxo-header-filter>
                    <dxo-paging [pageSize]="10"></dxo-paging>
                    <dxo-pager [showPageSizeSelector]="true" [allowedPageSizes]="[10, 20, 50]" [showInfo]="true">
                    </dxo-pager>

                    <dxo-grouping [autoExpandAll]="false"></dxo-grouping>
                    <div *dxTemplate="let data of 'groupCellTemplate'">
                        <div>{{GetDisplayText(data)}}</div>
                    </div>
                    <dxo-column-chooser #columnChooser [enabled]="true" mode="dragAndDrop">
                    </dxo-column-chooser>

                    <dxo-editing mode="popup" [allowUpdating]="true" [texts]="{editRow: 'Detay'}">
                        <dxo-popup title="Sevk Detay" [showTitle]="true" [width]="1000" [height]="615"
                            [closeOnOutsideClick]="true" [position]="{ my: 'center', at: 'center', of: 'window' }">
                            <dxi-toolbar-item></dxi-toolbar-item>
                        </dxo-popup>
                        <dxo-form>
                            <dxi-item itemType="group" caption="Fotoğraf" [colCount]="2" [colSpan]="2"
                            cssClass="statusLabel">
                            <div class="row">
                                <div class="col-sm-2">
                                    <!-- <label>Fotoğraf</label> -->
                                    <img id="myImage" [src]="PersonPicture" style="height: 120px;width: 100%;border-color:white;" />
                                </div>
                            </div>
                            </dxi-item>
                            <dxi-item itemType="group" caption="Kişi Bilgileri" [colCount]="2" [colSpan]="2"
                                cssClass="statusLabel">
                                <dxi-item dataField="tcKimlikNo" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="yabanciKimlikNo" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="adi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="soyadi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="anneAdi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="babaAdi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="cinsiyet" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="dogumTarihi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="dogumYeri" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="uyrugu" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="adres" [colSpan]="2" [editorOptions]="{ placeholder: ''}">
                                </dxi-item>
                            </dxi-item>
                            <dxi-item itemType="group" caption="Askeri Bilgileri" [colCount]="2" [colSpan]="2"
                                cssClass="statusLabel">
                                <dxi-item dataField="skBasvuruGrubu" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="kuvvet" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="kayitliOlduguAskerlikSubesi" [editorOptions]="{ placeholder: ''}">
                                </dxi-item>
                                <dxi-item dataField="okulu" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="birlik" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="birlikAciklama" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="sinifi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="rutbe" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="sicilNo" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="nasbi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="ucucuGorev" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="uctuguUcakTipi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                            </dxi-item>

                            <dxi-item itemType="group" caption="Sevk Bilgileri" [colCount]="2" [colSpan]="2"
                                cssClass="statusLabel">
                                <dxi-item dataField="sevkKayitNo" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="sevkKapsami" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="sevkKapsamiSehir" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="sevkKapsamiHastane" [editorOptions]="{ placeholder: ''}">
                                </dxi-item>
                                <dxi-item dataField="sevkEvrakTarihi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="sevkEvrakSayisi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="sevkTuru" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="sevkSiraNo" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="islemKayitTarihi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="muayeneSebebi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="muayeneGonderenMakam" [editorOptions]="{ placeholder: ''}">
                                </dxi-item>
                                <dxi-item dataField="muayaneyeGonderenMakamAciklamasi"
                                    [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="kacinciIslem" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="sonIslemTarihi" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="durumu" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="alimId" [editorOptions]="{ placeholder: ''}"></dxi-item>
                                <dxi-item dataField="aciklama" [editorOptions]="{ placeholder: ''}"></dxi-item>
                            </dxi-item>
                        </dxo-form>
                    </dxo-editing>
                    <dxi-column dataField="sevkSiraNo" caption="Sevk Sıra No" width="90" [allowEditing]="false"
                        groupCellTemplate="groupCellTemplate">
                    </dxi-column>
                    <dxi-column dataField="tcKimlikNo" caption="TC Kimlik No" width="90" [allowEditing]="false"
                        groupCellTemplate="groupCellTemplate">
                    </dxi-column>
                    <dxi-column dataField="yabanciKimlikNo" caption="Yabancı Kimlik No" width="90"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="adi" caption="Adı" width="100" [allowEditing]="false"
                        groupCellTemplate="groupCellTemplate"></dxi-column>
                    <dxi-column dataField="soyadi" caption="Soyadı" width="100" [allowEditing]="false"
                        groupCellTemplate="groupCellTemplate"></dxi-column>
                    <dxi-column dataField="skBasvuruGrubu" caption="Başvuru Grubu" width="80"
                        [mskbsGridColDefinition]="'admissiontype'" [visible]="true" [allowEditing]="false"
                        groupCellTemplate="groupCellTemplate">
                    </dxi-column>
                    <dxi-column dataField="kuvvet" caption="Kuvveti" width="80"
                        [mskbsGridColDefinition]="'forcescommand'" [visible]="false" [allowEditing]="false"
                        groupCellTemplate="groupCellTemplate">
                    </dxi-column>
                    <dxi-column dataField="birlik" caption="Birliği" width="80"
                        [mskbsGridColDefinition]="'militaryunit'" [visible]="false" [allowEditing]="false"
                        groupCellTemplate="groupCellTemplate"></dxi-column>
                    <dxi-column dataField="kayitliOlduguAskerlikSubesi" caption="Askerlik Şubesi" width="80"
                        groupCellTemplate="groupCellTemplate" [mskbsGridColDefinition]="'militaryoffice'"
                        [visible]="false" [allowEditing]="false">
                    </dxi-column>
                    <dxi-column dataField="muayeneSebebi" caption="Muayene Sebebi" width="200" [allowEditing]="false"
                        groupCellTemplate="groupCellTemplate">
                    </dxi-column>
                    <dxi-column dataField="anneAdi" caption="Anne Adı" width="80" [visible]="false"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="babaAdi" caption="Baba Adı" width="80" [visible]="false"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="cinsiyet" caption="Cinsiyet" width="70" [mskbsGridColDefinition]="'gender'"
                        groupCellTemplate="groupCellTemplate" [visible]="false" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="dogumTarihi" caption="Doğum Tarihi" width="100" dataType="date"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>

                    <dxi-column dataField="dogumYeri" caption="Doğum Yeri" width="80" [visible]="false"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>


                    <dxi-column dataField="uyrugu" caption="Uyruğu" width="100" [mskbsGridColDefinition]="'countryCode'"
                        groupCellTemplate="groupCellTemplate" [visible]="false" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="sevkEvrakTarihi" caption="Sevk Evrak Tarihi" width="90" dataType="date"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="sevkEvrakSayisi" caption="Sevk Evrak Sayısı" width="80"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="sevkKapsami" caption="Sevk Kapsamı" width="150"
                        groupCellTemplate="groupCellTemplate" [mskbsGridColDefinition]="'dispatchscope'"
                        [visible]="false" [allowEditing]="false">
                    </dxi-column>
                    <dxi-column dataField="sevkKapsamiSehir" caption="Sevk Kapsamı Şehir" width="150"
                        groupCellTemplate="groupCellTemplate" [mskbsGridColDefinition]="'city'" [visible]="false"
                        [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="sevkKapsamiHastane" caption="Sevk Kapsamı Hastane" width="250"
                        groupCellTemplate="groupCellTemplate" [mskbsGridColDefinition]="'hospitalCode'"
                        [visible]="false" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="islemKayitTarihi" caption="İşlem Kayıt Tarihi" width="100" dataType="date"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="sonIslemTarihi" caption="Son İşlem Tarihi" width="100" dataType="date"
                        groupCellTemplate="groupCellTemplate" [visible]="false" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="sevkTuru" caption="Sevk Türü" width="100" [allowEditing]="false"
                        groupCellTemplate="groupCellTemplate">
                    </dxi-column>
                    <dxi-column dataField="durumu" caption="Sevk Durumu" width="100"
                        groupCellTemplate="groupCellTemplate" [mskbsGridColDefinition]="'dispatchstate'"
                        [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="alimId" caption="Sevk Alım ID" width="100" [visible]="false"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="aciklama" caption="Açıklama" width="100" [visible]="false"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>

                    <dxi-column dataField="adres" caption="Adres" width="150" [visible]="false" [allowEditing]="false"
                        groupCellTemplate="groupCellTemplate">
                    </dxi-column>
                    <dxi-column dataField="sinifi" caption="Sınıfı" width="150" groupCellTemplate="groupCellTemplate"
                        [mskbsGridColDefinition]="'militaryclass'" [visible]="false" [allowEditing]="false">
                    </dxi-column>
                    <dxi-column dataField="rutbe" caption="Rütbesi" width="150" [mskbsGridColDefinition]="'rank'"
                        groupCellTemplate="groupCellTemplate" [visible]="false" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="sicilNo" caption="Sicili" width="150" [visible]="false"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="muayeneGonderenMakam" caption="Gönderen Makam" width="150"
                        groupCellTemplate="groupCellTemplate" [mskbsGridColDefinition]="'militaryunitandoffice'"
                        [visible]="false" [allowEditing]="false">
                    </dxi-column>
                    <dxi-column dataField="muayaneyeGonderenMakamAciklamasi" caption="Gönderen Makam Açıklaması"
                        groupCellTemplate="groupCellTemplate" width="150" [visible]="false" [allowEditing]="false">
                    </dxi-column>
                    <dxi-column dataField="okulu" caption="Okulu" width="150" groupCellTemplate="groupCellTemplate"
                        [mskbsGridColDefinition]="'militaryschool'" [visible]="false" [allowEditing]="false">
                    </dxi-column>
                    <dxi-column dataField="nasbi" caption="Nasbı" width="150" [visible]="false" dataType="date"
                        [allowEditing]="false">
                    </dxi-column>
                    <dxi-column dataField="ucucuGorev" caption="Uçucu Görev" width="150"
                        groupCellTemplate="groupCellTemplate" [mskbsGridColDefinition]="'flyingmission'"
                        [visible]="false" [allowEditing]="false">
                    </dxi-column>
                    <dxi-column dataField="uctuguUcakTipi" caption="Uçtuğu Uçak" width="150"
                        groupCellTemplate="groupCellTemplate" [mskbsGridColDefinition]="'planetype'" [visible]="false"
                        [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="kacinciIslem" caption="Kaçıncı İşlem" width="150" [visible]="false"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="birlikAciklama" caption="Birlik Açıklaması" width="150" [visible]="false"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>
                    <dxi-column dataField="sevkKayitNo" caption="Sevk Kayıt No" show="false" width="90"
                        groupCellTemplate="groupCellTemplate" [allowEditing]="false"></dxi-column>
                </dx-data-grid>
                <dx-load-panel
                 #loadPanel
                 shadingColor="rgba(0,0,0,0.4)"
                 [position]="{ my: 'center', at: 'center', of: 'window' }"
                 [(visible)]="loadingVisible"
                 [showIndicator]="true"
                 [showPane]="true"
                 [shading]="true">
                </dx-load-panel>
            </nb-card-body>
        </nb-card>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <nb-card class="inline-form-card">
            <nb-card-header id="header">Sevk İşlemleri</nb-card-header>
            <nb-card-body style="padding-bottom:0px">
                <div class="row">
                    <div class="col-sm-2" [hidden]="true">
                        <div class="form-group">
                            <dx-button (onClick)="editDispatch()" type="Default" style="width: 100%"
                                text="Sevk Bilgi Değiştir"></dx-button>
                        </div>
                    </div>
                    <div class="col-sm-2" [hidden]="isCancelDispatch">
                        <div class="form-group">
                            <dx-button id="btncancel" (onClick)="cancelDispatchStart()" type="Default" text="Sevk İptal"
                                [disabled]="isCancelDispatch"></dx-button>
                        </div>
                    </div>
                    <div class="col-sm-2" [hidden]="isGetProvisionWithDispatch">
                        <div class="form-group">
                            <dx-button id="btnprovision" (onClick)="requestProvision()" type="Default"
                                text="Provizyon Al" [disabled]="isGetProvisionWithDispatch"></dx-button>
                        </div>
                    </div>
                    <div class="col-sm-2" [hidden]="isAuditRecord">
                        <div class="form-group">
                            <dx-button id="btnQueryAudit" (onClick)="queryAudit()" type="Default" style="width: 100%"
                                text="İz Kaydı" [disabled]="isAuditRecord"></dx-button>
                        </div>
                    </div>
                </div>
            </nb-card-body>
        </nb-card>
    </div>
</div>

<dx-popup width="500px" height="250px" [(visible)]="cancelDesciptionOpen" title="İptal Açıklaması">
    <div *dxTemplate="let data of 'content'">
        <div class="row">
            <div class="col-md-12">
                <dx-text-area [height]="120" [(value)]="desciptionAreaValue">
                </dx-text-area>
            </div>
        </div>

        <br>
        <div class="row">
            <div class="col-sm-6">
                <dx-button id="btncancel" (onClick)="cancelDispatch()" type="Default" style="width: 100%"
                    text="İptal Et"></dx-button>
            </div>
            <div class="col-sm-6">
                <dx-button id="btnprovision" (onClick)="cancelDispatchExit()" type="Default" style="width: 100%"
                    text="Vazgeç"></dx-button>
            </div>
        </div>
    </div>
</dx-popup>

<dx-popup width="950px" height="650px" [(visible)]="auditOpen" title="İz Kaydı">
    <div *dxTemplate="let data of 'content'">
        <div class="row">
            <div class="col-md-12">
                <nb-card class="inline-form-card">
                    <nb-card-header>İz Kaydı Sorgulama Sonuçları</nb-card-header>
                    <nb-card-body>
                        <dx-data-grid [dataSource]="auditQueryResultList" [height]="200" [width]="'100%'"
                            [showBorders]="true"
                            (onSelectionChanged)="selectionChangedAudit($event.currentSelectedRowKeys)">
