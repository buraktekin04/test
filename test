import { Component, OnInit } from '@angular/core';
import { FormFieldConfig } from '../../model/form-field-config';
import { Validators } from '@angular/forms';
import { HttpClient, HttpHeaders } from '@angular/common/http';
import { IDispatchService } from '../../services/idispatch.service';
import { EnumItem } from '../../model/enum-item';
import { IDefinitionService } from '../../services/idefinition.service';
import { MilitaryUnitDef } from '../../model/militaryunitdef';
import { DispatchQueryCriteria } from '../../model/dispatch-query-criteria';
import { DispatchResult } from '../../model/dispatch-result';
import { Router, ActivatedRoute } from '@angular/router';
import { SevkSorgulaGiris } from '../../apimodel/sevksorgulagiris';
import { MSKBSResultCodes } from '../../model/mskbsresultcodes';
import { IMessageService } from '../../services/imessageservice';
import { SevkOzet } from '../../apimodel/sevkozet';
import { SevkIptalGiris } from '../../apimodel/sevkiptalgiris';
import { SevkDetayliSorgulaGiris } from '../../apimodel/sevkdetaylisorgulagiris';
import { Dispatch } from '../../model/dispatch';
import { isNullOrUndefined } from 'util';
import { Subscription } from 'rxjs';
import { AuthService } from '../../auth/services/auth.service';
import { EntityData } from '../../model/entitydata';
import { AuditActionData } from '../../model/auditactiondata';
import { AuditData } from '../../model/auditdata';
import { AuditDataDetail } from '../../model/auditdatadetail';
import { UserData } from '../../model/userdata';
import { IAuditService } from '../../services/iauditservice';
import MessagesTr from "devextreme/localization/messages/tr.json";
import { locale, loadMessages } from "devextreme/localization";

@Component({
  selector: 'mskbs-querydispatch',
  templateUrl: './querydispatch.component.html',
  styleUrls: ['./querydispatch.component.scss'],
})
export class QueryDispatchComponent implements OnInit {

  private paramsSub: Subscription;
  public selectedDispatch: SevkOzet;
  public sevkSorgulaGiris: SevkDetayliSorgulaGiris;
  public dispatchSummaryList: Array<SevkOzet>;
  public isQueryDispatch: boolean = false;
  public isCancelDispatch: boolean = false;
  public isGetProvisionWithDispatch: boolean = false;
  public isAuditRecord: boolean = false;
  public entityList: Array<EntityData>;
  public auditActionList: Array<AuditActionData>;
  public auditQueryResultList: Array<AuditData>;
  public auditQueryResultDetail: any;
  public newValue: Array<any>;
  public oldValue: Array<any>;
  public changeValue: Array<AuditDataDetail>;
  public userList: Array<UserData>;
  auditOpen: boolean = false;
  public fotografi: any;
  loadingVisible = false;

  constructor(private router: Router,
    private dispatchService: IDispatchService,
    private auditService: IAuditService,
    private authService: AuthService,
    private messageService: IMessageService,
    private activeRoute: ActivatedRoute) {
    this.sevkSorgulaGiris = new SevkDetayliSorgulaGiris();
    loadMessages(MessagesTr);
    locale('tr');
  }

  ngOnInit() {
    this.sevkSorgulaGiris.bagliOrganizasyonlar = false;

    const isSuperUser = this.authService.isSuperUser();
    if (!isSuperUser) {
      this.isQueryDispatch = !this.authService.isQueryDispatch();
      this.isCancelDispatch = !this.authService.isCancelDispatch();
      this.isGetProvisionWithDispatch = !this.authService.isGetProvisionWithDispatch();
      this.isAuditRecord = !this.authService.isAuditRecord();
    }

    //if (sessionStorage.getItem("DEV_TEST"))
    //{
    this.sevkSorgulaGiris.baslangicTarihi = new Date();
    this.sevkSorgulaGiris.bitisTarihi = new Date();
    //}

    this.auditService.userList().toPromise().then(result => {
      this.userList = result;
    });

  }

  contentReady(event: any) {
    event.component.columnOption("command:edit", "visibleIndex", -1);
  }

  public queryDispatch() {
    if (this.sevkSorgulaGiris.tcKimlikNo && !this.tcKimlikDogrulama(this.sevkSorgulaGiris.tcKimlikNo)) {
      this.messageService.showError("Girilen T.C. Kimlik Numarası geçersizdir.");
    }
    else {
      this.loadingVisible = true;
      const that = this;
      this.dispatchService.query(this.sevkSorgulaGiris).toPromise().then(result => {
        // this.dispatchSummaryList = result.sevkler;
        const message = `${result.sonucKodu}-${result.sonucMesaji}`;
        if (result.sonucKodu === MSKBSResultCodes.SuccessResultCode) {
          if (result.sevkler.length > 0) {
            this.loadingVisible = false;
            that.messageService.showInfo(message);
            that.dispatchSummaryList = result.sevkler;
          } else {
            this.loadingVisible = false;
            that.messageService.showError('Aranan kayıt bulunamadı!');
            that.dispatchSummaryList = null;
          }
        } else {
          this.loadingVisible = false;
          that.messageService.showError(message);
          that.dispatchSummaryList = null;
        }
      },
        error => {
          this.loadingVisible = false;
          if (error && error.message) {
            that.messageService.showError(error.message);
            that.dispatchSummaryList = null;
            if (error.status == 401 || error.status == 0) {
              const uri = `/kimlik/giris`;
              this.router.navigate([uri]);
            }
          } else {
            if (error) {
              that.messageService.showError(error.toString());
            }
          }
        });

    }

  }

  private tcKimlikDogrulama(tcKimlikNo: number): boolean {
    if (!tcKimlikNo) return true;
    let str = tcKimlikNo.toString();

    if (!/^\d{11}$/.test(str)) return false;

    let hane = str.split("").map(Number);
    if (hane[0] === 0) return false;

    let sumOdd = hane[0] + hane[2] + hane[4] + hane[6] + hane[8];
    let sumEven = hane[1] + hane[3] + hane[5] + hane[7];

    let checkDigit10 = ((sumOdd * 7) - sumEven) % 10;
    if (checkDigit10 !== hane[9]) return false;

    let totalSum = sumOdd + sumEven + hane[9];
    let checkDigit11 = totalSum % 10;
    if (checkDigit11 !== hane[10]) return false;

    return true;
  }

  public get PersonPicture(): string {
    const that = this;
    if (this.dispatchSummaryList != null && this.dispatchSummaryList.length > 0 && this.dispatchSummaryList[0].fotografi != null) {
      return 'data:image/jpeg;base64,' + that.dispatchSummaryList[0].fotografi;
    }
    return 'data:image/jpeg;base64,';
  }

  GetDisplayText(d) {
    return d.data.collapsedItems ? d.value + " ( Adet :  " + d.data.collapsedItems.length + " ) " : d.value + " ( Adet :  " + d.data.items.length + " ) ";
  }

  public onRowPrepared(info) {
    if (info.rowType === 'data') {
      if (info.data.durumu === Dispatch.States.CANCEL)
        info.rowElement.style.color = '#800000';
      else if (info.data.durumu === Dispatch.States.PROVISION || info.data.durumu === Dispatch.States.REPORT)
        info.rowElement.style.color = '#008000';
      else
        info.rowElement.style.fontWeight = 500;
    }
  }

  public editDispatch() {
    if (this.selectedDispatch) {
      const uri = `/mskbs/sevk/giris/${this.selectedDispatch.sevkKayitNo}`;
      this.router.navigate([uri]);
    }
  }

  cancelDesciptionOpen: boolean = false;
  desciptionAreaValue: string;

  cancelDispatchExit() {
    this.cancelDesciptionOpen = false;
    this.desciptionAreaValue = "";
  }

  cancelDispatchStart() {
    this.cancelDesciptionOpen = true;
  }




  public cancelDispatch() {
    const that = this;
    if (!this.selectedDispatch) {
      that.messageService.showError("İptal edilecek bir sevk işlemi seçilmemiştir.");
      return;
    }

    if (this.desciptionAreaValue == null) {
      that.messageService.showError("Açıklama boş geçilemez.");
      return;
    }
    /*  const result = confirm(`${this.selectedDispatch.sevkSiraNo} numaralı sevki iptal etmek istiyor musunuz?`);
     if (result === false) {
       return;
     } */

    const input = new SevkIptalGiris();
    input.sevkKayitNo = this.selectedDispatch.sevkKayitNo;
    input.aciklama = this.desciptionAreaValue;

    this.dispatchService.cancelDispatch(input).toPromise().then(res => {

      if (res.sonucKodu === MSKBSResultCodes.SuccessResultCode) {
        that.selectedDispatch.durumu = Dispatch.States.CANCEL;
        const message = `${this.selectedDispatch.sevkSiraNo} numaralı sevk iptal edilmiştir.`;
        that.messageService.showInfo(message);
        this.cancelDesciptionOpen = false;
        this.desciptionAreaValue = "";
      } else {
        const message = `${res.sonucKodu}-${res.sonucMesaji}`;
        that.messageService.showError(message);
      }
    },
      error => {
        if (error && error.message) {
          that.messageService.showError(error.message);
          if (error.status == 401 || error.status == 0) {
            const uri = `/kimlik/giris`;
            this.router.navigate([uri]);
          }
        } else {
          if (error) {
            that.messageService.showError(error.toString());
          }
        }
      });

  }

  public requestProvision() {
    if (this.selectedDispatch) {
      const uri = `/mskbs/provizyon/girissevkli/${this.selectedDispatch.sevkKayitNo}`;
      this.router.navigate([uri]);
    }
  }

  public selectionChanged(arg: Array<SevkOzet>) {
    if (arg && arg.length > 0) {
      this.selectedDispatch = arg[0];
    }
  }

  public queryAudit(): void {
    let that = this;
    if (this.selectedDispatch) {
      this.auditOpen = true;
      this.auditService.queryAuditForEntity(this.selectedDispatch.sevkKayitNo).toPromise().then(result => {
        that.auditQueryResultList = result;
      }, error => {
        this.messageService.showError(error);
      });
      //  const uri = `/mskbs/izkaydi/sorgula/${this.selectedDispatch.sevkKayitNo}/Sevk`;
      //  this.router.navigate([uri]);
    }
  }

  public selectionChangedAudit(data: any) {
    if (data != null) {
      this.changeValue = new Array<AuditDataDetail>();
      this.newValue = new Array<any>();
      this.oldValue = new Array<any>();
      const parseJson = (str: string): any => JSON.parse(str);
      this.auditQueryResultDetail = data as AuditData;
      let newValueParse: any;
      let oldValueParse: any;
      if (this.auditQueryResultDetail.length != 0) {
        newValueParse = parseJson(this.auditQueryResultDetail[0].newValues);
        oldValueParse = parseJson(this.auditQueryResultDetail[0].oldValues);
      }
      for (let itemUpdate in oldValueParse) {
        let chanceValueItem: AuditDataDetail = new AuditDataDetail();
        chanceValueItem.NesneAdi = itemUpdate;
        chanceValueItem.EskiVeri = oldValueParse[itemUpdate];
        if (newValueParse != null)
          chanceValueItem.YeniVeri = newValueParse[itemUpdate];
        this.changeValue.push(chanceValueItem);
      }
    }
  }
  onRowPreparedAudit(e) {
    if (e.rowType == 'data') {
      if (e.data.EskiVeri != e.data.YeniVeri) {
        e.rowElement.style.backgroundColor = 'yellow';
        e.rowElement.className = e.rowElement.className.replace("dx-row-alt", "");
      }
    }
  }
}


