private previewFile(
    responseBody: any,
    contentType: string,
    fileName: string
) {
    const blob = new Blob(
        [responseBody],
        { type: contentType }
    );

    const url = window.URL.createObjectURL(blob);

    window.open(url, '_blank');
}

public dispatchFileSelectionChanged(e: any) {

    if (e.rowType !== 'data') {
        return;
    }

    const dispatchFileId = e.data.dispatchFileId;

    if (!dispatchFileId) {
        return;
    }

    console.log('Tıklanan dosya:', dispatchFileId);

    this.fileUploadService
        .downloadDispatchFile(dispatchFileId)
        .toPromise()
        .then(response => {

            const contentType =
                response.headers.get('content-type') ||
                'application/octet-stream';

            console.log('Gelen dosya tipi:', contentType);

            this.previewFile(
                response.body,
                contentType,
                dispatchFileId
            );

        })
        .catch(error => {
            console.error('Dosya getirilemedi:', error);
        });
}
