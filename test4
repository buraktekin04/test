            Address = provizyonGiris.Adres,
            RegistryNumber = provizyonGiris.SicilNo,
            LastNominationDate = provizyonGiris.Nasbi,
            AutomaticDispatch = true,
            MilitaryUnitDescription = provizyonGiris.BirlikAciklama,
            SenderChairOther = provizyonGiris.MuayeneyeGonderenMakamAciklama,
            PurchaseId = provizyonGiris.AlimId,
        };
        if (Guid.TryParse(provizyonGiris.MuayeneSebebi, out Guid reasonForExamination))
            dispatch.ReasonForExamination = reasonForExamination;


        if (provizyonGiris.DogumYeri != null)
        {
            var townOfBirth = _personService.GetTownOfBirth(Int32.Parse(provizyonGiris.DogumYeri));
            if (townOfBirth.HasValue)
