            DispatchDocumentDate = provizyonGiris.SevkEvrakTarihi.Date,
            DispatchDocumentNo = provizyonGiris.SevkEvrakSayisi,
            UniqueRefno = provizyonGiris.TCKimlikNo,
            ForeignUniqueRefno = provizyonGiris.YabanciKimlikNo,
            Name = provizyonGiris.Adi,
            Surname = provizyonGiris.Soyadi,
            FatherName = provizyonGiris.BabaAdi,
            MotherName = provizyonGiris.AnneAdi,
            BirthDate = provizyonGiris.DogumTarihi.Date,
