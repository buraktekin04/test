                dispatch.TownOfBirth = townOfBirth.Value;
                dispatch.BdPlace = placeName;
                dispatch.BdCode = provizyonGiris.DogumYeri;
            }
        }

        if (provizyonGiris.Uyrugu != null)
        {
            var nationality = _personService.GetCountryObjectId(provizyonGiris.Uyrugu);
            if (nationality.HasValue)
                dispatch.Nationality = nationality.Value;
        }

        if (Guid.TryParse(provizyonGiris.SKBasvuruGrubu, out Guid dispatchHcAdmissionType))
            dispatch.HcAdmissionTypeDef = dispatchHcAdmissionType;

        if (Guid.TryParse(provizyonGiris.Kuvvet, out Guid dispatchForcesCommand))
            dispatch.ForcesCommand = dispatchForcesCommand;

        if (Guid.TryParse(provizyonGiris.Rutbe, out Guid dispatchRank))
            dispatch.Rank = dispatchRank;

        if (Guid.TryParse(provizyonGiris.Sinif, out Guid dispatchMilitaryClass))
            dispatch.MilitaryClass = dispatchMilitaryClass;

        if (Guid.TryParse(provizyonGiris.Birlik, out Guid dispatchMilitaryUnit))
            dispatch.MilitaryUnit = dispatchMilitaryUnit;

        if (Guid.TryParse(provizyonGiris.Okulu, out Guid dispatchMilitarySchool))
            dispatch.MilitarySchool = dispatchMilitarySchool;

        if (Guid.TryParse(provizyonGiris.KayitliOlduguAskerlikSubesi, out Guid dispatchMilitaryOffice))
            dispatch.MilitaryOffice = dispatchMilitaryOffice;

        if (Guid.TryParse(provizyonGiris.MuayeneyeGonderenMakam, out Guid dispatchSenderChair))
            dispatch.SenderChair = dispatchSenderChair;

        if (Guid.TryParse(provizyonGiris.UcucuGorevi, out Guid dispatchFlyingMission))
            dispatch.FlyingMission = dispatchFlyingMission;

        if (Guid.TryParse(provizyonGiris.UctuguUcakTipi, out Guid dispatchFlyingPlaneType))
            dispatch.FlyingPlaneType = dispatchFlyingPlaneType;

        var dispatchInput = new DispatchNewInput
