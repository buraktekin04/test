   [HttpPost]
   [ProducesResponseType(typeof(ProvizyonYeniCevap), 200)]
   [ProducesResponseType(404)]
   [MSKBSAuthorizeRole(MSKBSRoleNames.ProvizyonYeniSevkli)]
   public IActionResult YeniSevkli([FromBody] ProvizyonSevkliYeniGiris provizyonGiris)
   {
       if (!ModelState.IsValid)
       {
           return BadRequest(ModelState);
       }

       var cevap = new ProvizyonYeniCevap();

       try
       {
           var input = Newtonsoft.Json.JsonConvert.SerializeObject(provizyonGiris);
           _logger.LogInformation($"Provizyon/YeniSevkli Giriş {input}");

           var provisionInput = new ProvisionWithDispatchInput
           {
               DispatchObjectId = provizyonGiris.SevkKayitNo.SafeParseNullableGuid()
           };

           if (provizyonGiris.KabulYapanHastane != null)
           {
               var hospital = _provisionService.GetHospitalObjectId(provizyonGiris.KabulYapanHastane);
               if (hospital.HasValue)
                   provisionInput.AdmissionHospital = hospital.Value;
           }

           var result = _provisionService.NewProvision(provisionInput);
           cevap.ProvizyonKayitNo = result.ObjectId.ToString();
           cevap.ProvizyonSiraNo = result.ProvisionRecordNumber;

           var Branslar = new List<string>();
           foreach (var item in result.Branches)
           {
               Branslar.Add(item);
           }
           cevap.Branslar = Branslar;

           var Tetkikler = new List<string>();
           foreach (var item in result.Procedures)
           {
               Tetkikler.Add(item);
           }
           cevap.Tetkikler = Tetkikler;
           cevap.SevkAlimId = result.PurchaseId;

           cevap.SetSuccessResult();
           var output = Newtonsoft.Json.JsonConvert.SerializeObject(cevap);
           _logger.LogInformation($"Provizyon/YeniSevkli Cevap {output}");

       }
       catch (MSKBSValidationException ex)
       {
           cevap.SonucKodu = MSKBSResultCodes.ValidationErrorResultCode;
           cevap.SonucMesaji = ex.Message;
           _logger.LogError(ex.ToString());
       }
       catch (MSKBSBusinessException ex)
       {
           cevap.SonucKodu = ex.ResultCode;
           cevap.SonucMesaji = ex.ResultMessage;
           _logger.LogError(ex.ToString());
       }

       return Ok(cevap);
   }
   
   
   
   
   
   
   
   
   
   
   
   
   
   
   
[HttpPost]
