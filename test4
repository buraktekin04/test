
[HttpPost]
[ProducesResponseType(typeof(ProvizyonSorgulaCevap), 200)]
[ProducesResponseType(404)]
[MSKBSAuthorizeRole(MSKBSRoleNames.ProvizyonSorgula)]
public IActionResult SorgulaDetayli([FromBody] ProvizyonDetayliSorgulaGiris sorgulaGiris)
{
    if (!ModelState.IsValid)
    {
        return BadRequest(ModelState);
    }

    var cevap = new ProvizyonSorgulaCevap();

    try
    {
        var input = Newtonsoft.Json.JsonConvert.SerializeObject(sorgulaGiris);
        _logger.LogInformation($"Provizyon/SorgulaDetayli Giriş {input}");

        var queryInput = new ProvisionDetailedQueryInput
        {
            UniqueRefno = sorgulaGiris.TCKimlikNo,
            ForeignUniqueRefno = sorgulaGiris.YabanciKimlikNo,
            Name = sorgulaGiris.Adi,
            Surname = sorgulaGiris.Soyadi,
            ProvisionDateFrom = sorgulaGiris.BaslangicTarihi,
            ProvisionDateTo = sorgulaGiris.BitisTarihi,
            ProvisionNo = sorgulaGiris.ProvizyonSiraNo,
            Hospital = sorgulaGiris.Hastane,
            ConnectedOrganizations = sorgulaGiris.BagliOrganizasyonlar
        };

        if (sorgulaGiris.ProvizyonDurumu.HasValue)
        {
            queryInput.ProvisionState = (Provision.States)sorgulaGiris.ProvizyonDurumu.Value;
        }

        var result = _provisionService.QueryProvision(queryInput);

        var queryResult = from r in result
                          let provizyonOzet = MapToProvizyonOzetTo(r)
                          select provizyonOzet;

        cevap.Provizyonlar = queryResult.ToArray();
        cevap.SetSuccessResult();
        var output = Newtonsoft.Json.JsonConvert.SerializeObject(cevap);
        _logger.LogInformation($"Provizyon/SorgulaDetayli Cevap {output}");

    }
    catch (MSKBSValidationException ex)
    {
        cevap.SonucKodu = MSKBSResultCodes.ValidationErrorResultCode;
        cevap.SonucMesaji = ex.Message;
        _logger.LogError(ex.ToString());
    }
    catch (MSKBSBusinessException ex)
    {
        cevap.SonucKodu = ex.ResultCode;
        cevap.SonucMesaji = ex.ResultMessage;
        _logger.LogError(ex.ToString());
    }

    return Ok(cevap);
}









